---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { employeeName, loadDashboardData } from '@/lib/dashboard-data';
import { formatDate, formatIDR } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.reviewAllowance);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employee = Astro.url.searchParams.get('employee') ?? '';
const status = Astro.url.searchParams.get('status') ?? 'submitted';
const entries = (data?.allowances ?? []).filter((row) => (!employee || row.employee_id === employee) && (!status || row.status === status));
const employees = data?.profiles.filter((row) => row.role === 'employee') ?? [];
---

<AppLayout title="Review tunjangan" heading="Tunjangan" description="Verifikasi pengajuan biaya transportasi dan makan." role="admin" user={user} activePath="/admin/allowances">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  <section class="panel">
    <div class="panel-header"><form method="GET" class="filters"><select class="select" name="employee"><option value="">Semua karyawan</option>{employees.map((row) => <option value={row.id} selected={employee === row.id}>{row.full_name}</option>)}</select><select class="select" name="status"><option value="">Semua status</option>{['draft','submitted','approved','rejected'].map((value) => <option value={value} selected={status === value}>{value}</option>)}</select><button class="button secondary">Terapkan</button></form></div>
    {entries.length ? <div class="review-list">{entries.map((row) => <article><header><div><strong>{employeeName(data!, row.employee_id)}</strong><span>{formatDate(row.expense_date)}</span></div><StatusBadge label={row.status} tone={row.status === 'approved' ? 'success' : row.status === 'rejected' ? 'danger' : 'warning'} /></header><dl><div><dt>Transportasi</dt><dd>{formatIDR(row.transport_amount)}</dd></div><div><dt>Makan</dt><dd>{formatIDR(row.meal_amount)}</dd></div><div><dt>Total</dt><dd><strong>{formatIDR(row.transport_amount + row.meal_amount)}</strong></dd></div></dl>{row.notes && <p>{row.notes}</p>}{row.status === 'submitted' ? <form method="POST" action={actions.reviewAllowance} class="review-form"><input type="hidden" name="allowanceId" value={row.id} /><textarea class="textarea" name="reviewNote" placeholder="Catatan wajib jika ditolak"></textarea><div class="cluster"><button class="button secondary" name="decision" value="rejected">Tolak</button><button class="button" name="decision" value="approved">Setujui</button></div></form> : row.review_note && <div class="alert">{row.review_note}</div>}</article>)}</div> : <EmptyState title="Tidak ada pengajuan" description="Tidak ada tunjangan yang cocok dengan filter." />}
  </section>
</AppLayout>

<style>.filters{display:grid;gap:.6rem}.review-list{display:grid;gap:1px;background:var(--line)}.review-list article{padding:1rem;background:white}header{display:flex;justify-content:space-between}header>div{display:grid}header span,.review-list p{color:var(--muted);font-size:.75rem}dl{display:grid;gap:.5rem;margin:1rem 0}dl div{display:flex;justify-content:space-between}dt{color:var(--muted)}dd{margin:0}.review-form{display:grid;gap:.7rem;margin-top:1rem}@media(min-width:700px){.filters{grid-template-columns:240px 200px auto}}@media(min-width:1000px){.review-list{grid-template-columns:1fr 1fr}}</style>
