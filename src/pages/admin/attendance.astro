---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { employeeName, loadDashboardData } from '@/lib/dashboard-data';
import { formatDate, formatDateTime } from '@/lib/formatters';
import { netHours } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.reviewAttendance);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employee = Astro.url.searchParams.get('employee') ?? '';
const status = Astro.url.searchParams.get('status') ?? 'submitted';
const sessions = (data?.sessions ?? []).filter((row) => (!employee || row.employee_id === employee) && (!status || row.status === status));
const employees = data?.profiles.filter((row) => row.role === 'employee') ?? [];
---

<AppLayout title="Review absensi" heading="Absensi" description="Tinjau durasi dan catatan aktivitas karyawan." role="admin" user={user} activePath="/admin/attendance">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  <section class="panel">
    <div class="panel-header"><form method="GET" class="filters"><select class="select" name="employee"><option value="">Semua karyawan</option>{employees.map((row) => <option value={row.id} selected={employee === row.id}>{row.full_name}</option>)}</select><select class="select" name="status"><option value="">Semua status</option>{['draft','submitted','approved','rejected'].map((value) => <option value={value} selected={status === value}>{value}</option>)}</select><button class="button secondary">Terapkan</button></form></div>
    {sessions.length ? <div class="review-list">{sessions.map((row) => <article><div class="review-main"><div><strong>{employeeName(data!, row.employee_id)}</strong><span>{formatDate(row.work_date)} · {row.work_mode}</span></div><StatusBadge label={row.status} tone={row.status === 'approved' ? 'success' : row.status === 'rejected' ? 'danger' : 'warning'} /></div><dl><div><dt>Check-in</dt><dd>{formatDateTime(row.check_in)}</dd></div><div><dt>Check-out</dt><dd>{row.check_out ? formatDateTime(row.check_out) : '—'}</dd></div><div><dt>Durasi bersih</dt><dd>{netHours(row.check_in, row.check_out, row.break_minutes).toFixed(1)} jam</dd></div></dl>{row.activity_note && <p>{row.activity_note}</p>}{row.status === 'submitted' ? <form method="POST" action={actions.reviewAttendance} class="review-form"><input type="hidden" name="sessionId" value={row.id} /><textarea class="textarea" name="reviewNote" placeholder="Catatan wajib jika ditolak"></textarea><div class="cluster"><button class="button secondary" name="decision" value="rejected">Tolak</button><button class="button" name="decision" value="approved">Setujui</button></div></form> : row.review_note && <div class="alert">{row.review_note}</div>}</article>)}</div> : <EmptyState title="Tidak ada absensi" description="Tidak ada data yang cocok dengan filter." />}
  </section>
</AppLayout>

<style>.filters{display:grid;gap:.6rem}.review-list article{padding:1rem 1.2rem;border-bottom:1px solid var(--line)}.review-main{display:flex;justify-content:space-between;gap:1rem}.review-main>div{display:grid}.review-main span{color:var(--muted);font-size:.75rem}dl{display:grid;gap:.5rem;margin:1rem 0}dl div{display:flex;justify-content:space-between}dt{color:var(--muted)}dd{margin:0}.review-list p{color:var(--muted)}.review-form{display:grid;gap:.7rem;margin-top:1rem}@media(min-width:700px){.filters{grid-template-columns:240px 200px auto}.review-list article{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.review-form,.review-list article>p,.review-list article>.alert{grid-column:1/-1}}</style>
