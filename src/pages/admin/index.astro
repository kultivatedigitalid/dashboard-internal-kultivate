---
import AppLayout from '@/layouts/AppLayout.astro';
import StatBlock from '@/components/StatBlock.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import TaskRow from '@/components/TaskRow.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData, employeeName, toDashboardTask } from '@/lib/dashboard-data';
import { formatDateTime } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
let loadError = '';
let data: Awaited<ReturnType<typeof loadDashboardData>> | undefined;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employees = data?.profiles.filter((row) => row.role === 'employee') ?? [];
const pendingSessions = data?.sessions.filter((row) => row.status === 'submitted') ?? [];
const pendingReports = data?.reports.filter((row) => row.status === 'submitted') ?? [];
const allTasks = data?.tasks ?? [];
const activeTasks = allTasks.filter((row) => row.status !== 'completed');
const urgentTasks = activeTasks.filter((row) => row.priority === 'urgent');
const priorityRank = { urgent: 0, todo: 1 } as const;
const taskPreview = [...activeTasks].sort((a, b) => priorityRank[a.priority] - priorityRank[b.priority] || (a.due_date ?? '9999').localeCompare(b.due_date ?? '9999')).slice(0, 5);
const recent = [
  ...pendingSessions.map((row) => ({ person: employeeName(data!, row.employee_id), type: 'Absensi', at: row.check_in, href: '/admin/attendance' })),
  ...pendingReports.map((row) => ({ person: employeeName(data!, row.employee_id), type: 'Laporan', at: row.submitted_at ?? row.week_start, href: '/admin/reports' })),
].sort((a, b) => Date.parse(b.at) - Date.parse(a.at)).slice(0, 6);
---

<AppLayout title="Admin dashboard" heading="Dashboard admin" description="Pantau pekerjaan tim, progress tugas, dan antrean operasional." role="admin" user={user} activePath="/admin">
  <a slot="actions" class="button" href="/admin/tasks/new"><i class="ph ph-plus" aria-hidden="true"></i>Buat tugas</a>
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  <section class="metrics-grid">
    <StatBlock label="Karyawan aktif" value={String(employees.filter((row) => row.is_active).length)} helper={`${employees.length} total akun`} />
    <StatBlock label="Tugas aktif" value={String(activeTasks.length)} helper={`${allTasks.filter((row) => row.status === 'completed').length} selesai`} />
    <StatBlock label="Tugas urgent" value={String(urgentTasks.length)} helper="perlu perhatian" tone={urgentTasks.length ? 'warning' : 'success'} />
    <StatBlock label="Menunggu review" value={String(pendingSessions.length + pendingReports.length)} helper="absensi dan laporan" tone={pendingSessions.length + pendingReports.length ? 'warning' : 'success'} />
  </section>

  <div class="dashboard-grid">
    <section class="panel task-panel">
      <div class="panel-header"><div><h2>Task Manager</h2><p>Tugas aktif diurutkan berdasarkan urgency dan deadline.</p></div><a class="text-link" href="/admin/tasks">Kelola semua</a></div>
      {taskPreview.length && data ? taskPreview.map((task) => <TaskRow task={toDashboardTask(task, data)} admin />) : <EmptyState title="Belum ada tugas aktif" description="Buat tugas pertama untuk memulai pekerjaan tim." actionLabel="Buat tugas" actionHref="/admin/tasks/new" />}
    </section>

    <aside class="stack">
      <section class="panel">
        <div class="panel-header"><div><h2>Antrean review</h2><p>Item terbaru yang belum diproses.</p></div></div>
        {recent.length ? <div>{recent.map((item) => <a class="queue-row" href={item.href}><div><strong>{item.person}</strong><span>{item.type}</span></div><small>{formatDateTime(item.at)}</small><StatusBadge label="Menunggu" tone="warning" /></a>)}</div> : <EmptyState title="Antrean kosong" description="Tidak ada item yang menunggu review." />}
      </section>
      <section class="panel panel-body stack quick-links"><h2>Akses cepat</h2><a class="button secondary" href="/admin/employees">Kelola karyawan</a><a class="button secondary" href="/admin/attendance">Review absensi</a><a class="button secondary" href="/admin/reports">Review laporan</a></section>
    </aside>
  </div>
</AppLayout>

<style>.metrics-grid{margin-bottom:1rem}.dashboard-grid{display:grid;gap:1rem}.task-panel{overflow:hidden}.queue-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.45rem;padding:1rem 1.1rem;border-bottom:1px solid var(--line)}.queue-row div{display:grid}.queue-row span,.queue-row small{color:var(--muted);font-size:.72rem}.queue-row :global(.status-badge){grid-column:2}.quick-links h2{font-size:.9rem}@media(min-width:1050px){.dashboard-grid{grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);align-items:start}}</style>