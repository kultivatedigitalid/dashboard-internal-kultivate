---
import AppLayout from '@/layouts/AppLayout.astro';
import StatBlock from '@/components/StatBlock.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData, employeeName } from '@/lib/dashboard-data';
import { formatDateTime } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employees = data?.profiles.filter((row) => row.role === 'employee') ?? [];
const pendingSessions = data?.sessions.filter((row) => row.status === 'submitted') ?? [];
const pendingReports = data?.reports.filter((row) => row.status === 'submitted') ?? [];
const pendingAllowances = data?.allowances.filter((row) => row.status === 'submitted') ?? [];
const activeTasks = data?.tasks.filter((row) => !['draft', 'completed', 'archived'].includes(row.status)) ?? [];
const recent = [
  ...pendingSessions.map((row) => ({ person: employeeName(data!, row.employee_id), type: 'Absensi', at: row.check_in, href: '/admin/attendance' })),
  ...pendingReports.map((row) => ({ person: employeeName(data!, row.employee_id), type: 'Laporan', at: row.submitted_at ?? row.week_start, href: '/admin/reports' })),
  ...pendingAllowances.map((row) => ({ person: employeeName(data!, row.employee_id), type: 'Tunjangan', at: row.submitted_at ?? row.expense_date, href: '/admin/allowances' })),
].sort((a, b) => Date.parse(b.at) - Date.parse(a.at)).slice(0, 8);
---

<AppLayout title="Admin dashboard" heading="Dashboard admin" description="Ringkasan operasional dan item yang membutuhkan review." role="admin" user={user} activePath="/admin">
  <a slot="actions" class="button" href="/admin/tasks/new">Buat tugas</a>
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  <section class="metrics-grid">
    <StatBlock label="Karyawan aktif" value={String(employees.filter((row) => row.is_active).length)} helper={`${employees.length} total akun`} />
    <StatBlock label="Tugas aktif" value={String(activeTasks.length)} helper="seluruh tim" />
    <StatBlock label="Absensi menunggu" value={String(pendingSessions.length)} helper="perlu review" tone={pendingSessions.length ? 'warning' : 'success'} />
    <StatBlock label="Laporan & tunjangan" value={String(pendingReports.length + pendingAllowances.length)} helper="perlu review" tone={pendingReports.length + pendingAllowances.length ? 'warning' : 'success'} />
  </section>
  <div class="admin-grid">
    <section class="panel">
      <div class="panel-header"><div><h2>Antrean review</h2><p>Item terbaru yang belum diproses.</p></div></div>
      {recent.length ? <div>{recent.map((item) => <a class="queue-row" href={item.href}><div><strong>{item.person}</strong><span>{item.type}</span></div><small>{formatDateTime(item.at)}</small><StatusBadge label="Menunggu" tone="warning" /></a>)}</div> : <EmptyState title="Antrean kosong" description="Tidak ada item yang menunggu review." />}
    </section>
    <aside class="panel panel-body stack">
      <h2>Akses cepat</h2>
      <a class="button secondary" href="/admin/employees">Kelola karyawan</a>
      <a class="button secondary" href="/admin/attendance">Review absensi</a>
      <a class="button secondary" href="/admin/reports">Review laporan</a>
      <a class="button secondary" href="/admin/allowances">Review tunjangan</a>
    </aside>
  </div>
</AppLayout>

<style>.metrics-grid{margin-bottom:1rem}.admin-grid{display:grid;gap:1rem}.queue-row{display:grid;grid-template-columns:1fr auto;gap:.5rem;padding:1rem 1.1rem;border-bottom:1px solid var(--line)}.queue-row div{display:grid}.queue-row span,.queue-row small{color:var(--muted);font-size:.72rem}.queue-row :global(.status-badge){grid-column:2}@media(min-width:900px){.admin-grid{grid-template-columns:1.4fr .6fr}}</style>
