---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { employeeName, loadDashboardData } from '@/lib/dashboard-data';
import { formatDate, formatDateTime } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.reviewReport);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employee = Astro.url.searchParams.get('employee') ?? '';
const status = Astro.url.searchParams.get('status') ?? 'submitted';
const reports = (data?.reports ?? []).filter((row) => (!employee || row.employee_id === employee) && (!status || row.status === status));
const employees = data?.profiles.filter((row) => row.role === 'employee') ?? [];
---

<AppLayout title="Review laporan" heading="Laporan mingguan" description="Tinjau isi laporan dan berikan feedback." role="admin" user={user} activePath="/admin/reports">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  <section class="panel">
    <div class="panel-header"><form method="GET" class="filters"><select class="select" name="employee"><option value="">Semua karyawan</option>{employees.map((row) => <option value={row.id} selected={employee === row.id}>{row.full_name}</option>)}</select><select class="select" name="status"><option value="">Semua status</option>{['draft','submitted','approved','rejected'].map((value) => <option value={value} selected={status === value}>{value}</option>)}</select><button class="button secondary">Terapkan</button></form></div>
    {reports.length ? <div class="review-list">{reports.map((row) => <article><header><div><strong>{employeeName(data!, row.employee_id)}</strong><span>Minggu mulai {formatDate(row.week_start)}{row.submitted_at ? ` · ${formatDateTime(row.submitted_at)}` : ''}</span></div><StatusBadge label={row.status} tone={row.status === 'approved' ? 'success' : row.status === 'rejected' ? 'danger' : 'warning'} /></header><section><strong>Ringkasan</strong><p>{row.summary || '—'}</p></section><div class="two"><section><strong>Pencapaian</strong><p>{row.achievements || '—'}</p></section><section><strong>Kendala</strong><p>{row.blockers || '—'}</p></section></div><section><strong>Rencana</strong><p>{row.next_plan || '—'}</p></section>{row.video_url && <a href={row.video_url} target="_blank" rel="noreferrer">Buka video ↗</a>}{row.status === 'submitted' ? <form method="POST" action={actions.reviewReport} class="review-form"><input type="hidden" name="reportId" value={row.id} /><textarea class="textarea" name="reviewNote" placeholder="Feedback (wajib jika revisi)"></textarea><div class="cluster"><button class="button secondary" name="decision" value="rejected">Minta revisi</button><button class="button" name="decision" value="approved">Tandai reviewed</button></div></form> : row.review_note && <div class="alert">{row.review_note}</div>}</article>)}</div> : <EmptyState title="Tidak ada laporan" description="Tidak ada laporan yang cocok dengan filter." />}
  </section>
</AppLayout>

<style>.filters{display:grid;gap:.6rem}.review-list article{padding:1.2rem;border-bottom:1px solid var(--line)}header{display:flex;justify-content:space-between;gap:1rem;margin-bottom:1rem}header>div{display:grid}header span,.review-list p{color:var(--muted)}header span{font-size:.75rem}.review-list section{margin:.8rem 0}.review-list a{color:var(--primary)}.two{display:grid;gap:1rem}.review-form{display:grid;gap:.7rem;margin-top:1rem}@media(min-width:700px){.filters{grid-template-columns:240px 200px auto}.two{grid-template-columns:1fr 1fr}}</style>
