---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { employeeName, loadDashboardData } from '@/lib/dashboard-data';
import { formatDate } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.createEvaluation);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const selectedEmployee = Astro.url.searchParams.get('employee') ?? '';
const employees = data?.profiles.filter((row) => row.role === 'employee' && row.is_active) ?? [];
const evaluations = data?.evaluations.filter((row) => !selectedEmployee || row.employee_id === selectedEmployee) ?? [];
---

<AppLayout title="Evaluasi" heading="Evaluasi" description="Simpan feedback privat atau publikasikan kepada karyawan." role="admin" user={user} activePath="/admin/evaluations">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  <section class="panel">
    <div class="panel-header"><div><h2>Evaluasi baru</h2></div></div>
    <form method="POST" action={actions.createEvaluation} class="panel-body evaluation-form">
      <label class="field">Karyawan<select class="select" name="employeeId" required><option value="">Pilih karyawan</option>{employees.map((row) => <option value={row.id} selected={selectedEmployee === row.id}>{row.full_name}</option>)}</select></label>
      <label class="field">Nilai<select class="select" name="score"><option value="">Tanpa nilai</option>{[5,4,3,2,1].map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="field">Visibilitas<select class="select" name="visibility"><option value="employee">Terlihat karyawan</option><option value="admin">Admin saja</option></select></label>
      <label class="field wide">Judul<input class="input" name="title" required /></label>
      <label class="field wide">Catatan<textarea class="textarea tall" name="notes" required></textarea></label>
      <div class="cluster wide"><button class="button secondary" name="intent" value="draft">Simpan draft</button><button class="button" name="intent" value="publish">Publikasikan</button></div>
    </form>
  </section>
  <section class="panel history">
    <div class="panel-header"><div><h2>Riwayat evaluasi</h2></div><form method="GET"><select class="select" name="employee" onchange="this.form.submit()"><option value="">Semua karyawan</option>{employees.map((row) => <option value={row.id} selected={selectedEmployee === row.id}>{row.full_name}</option>)}</select></form></div>
    {evaluations.length ? <div class="table-wrap"><table><thead><tr><th>Karyawan</th><th>Judul</th><th>Tanggal</th><th>Nilai</th><th>Visibilitas</th><th>Status</th></tr></thead><tbody>{evaluations.map((row) => <tr><td>{employeeName(data!, row.employee_id)}</td><td><strong>{row.title}</strong></td><td>{formatDate(row.published_at ?? row.created_at)}</td><td>{row.score ?? '—'}</td><td>{row.visibility}</td><td><StatusBadge label={row.is_published ? 'Published' : 'Draft'} tone={row.is_published ? 'success' : 'neutral'} /></td></tr>)}</tbody></table></div> : <EmptyState title="Belum ada evaluasi" description="Evaluasi yang dibuat akan muncul di sini." />}
  </section>
</AppLayout>

<style>.evaluation-form{display:grid;gap:1rem}.history{margin-top:1rem}.tall{min-height:140px}@media(min-width:760px){.evaluation-form{grid-template-columns:repeat(3,1fr)}.wide{grid-column:1/-1}}</style>
