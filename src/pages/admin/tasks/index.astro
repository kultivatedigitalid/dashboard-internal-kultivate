---
import AppLayout from '@/layouts/AppLayout.astro';
import TaskRow from '@/components/TaskRow.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData, toDashboardTask } from '@/lib/dashboard-data';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const q = Astro.url.searchParams.get('q')?.toLowerCase() ?? '';
const employee = Astro.url.searchParams.get('employee') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const tasks = (data?.tasks ?? []).filter((row) => (!q || row.title.toLowerCase().includes(q)) && (!employee || row.assignee_id === employee) && (!status || row.status === status));
const employees = data?.profiles.filter((row) => row.role === 'employee') ?? [];
---

<AppLayout title="Tugas admin" heading="Tugas" description="Buat, edit, dan pantau progres tugas seluruh tim." role="admin" user={user} activePath="/admin/tasks">
  <a slot="actions" class="button" href="/admin/tasks/new">Buat tugas baru</a>
  {loadError && <div class="alert danger">{loadError}</div>}
  <section class="panel">
    <div class="panel-header"><form method="GET" class="filters"><input class="input" name="q" value={q} placeholder="Cari tugas..." /><select class="select" name="employee"><option value="">Semua karyawan</option>{employees.map((row) => <option value={row.id} selected={employee === row.id}>{row.full_name}</option>)}</select><select class="select" name="status"><option value="">Semua status</option>{['draft','not_started','in_progress','in_review','completed','archived'].map((value) => <option value={value} selected={status === value}>{value}</option>)}</select><button class="button secondary">Terapkan</button></form></div>
    {tasks.length && data ? tasks.map((task) => <TaskRow task={toDashboardTask(task, data)} admin />) : <EmptyState title="Tidak ada tugas" description="Buat tugas baru atau ubah filter." actionLabel="Buat tugas" actionHref="/admin/tasks/new" />}
  </section>
</AppLayout>

<style>.filters{width:100%;display:grid;gap:.6rem}@media(min-width:900px){.filters{grid-template-columns:1fr 220px 190px auto}}</style>
