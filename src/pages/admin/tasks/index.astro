---
import AppLayout from '@/layouts/AppLayout.astro';
import TaskRow from '@/components/TaskRow.astro';
import StatBlock from '@/components/StatBlock.astro';
import { adminUser, employeeTasks } from '@/lib/demo-data';

const user = Astro.locals.user ?? adminUser;
const allTasks = [
  ...employeeTasks,
  ...employeeTasks.map((task, index) => ({ ...task, id: `airin-${task.id}`, assignee: 'Airin Frantrishia Lay', progress: Math.max(20, task.progress - 12 + index * 4) })),
  ...employeeTasks.map((task, index) => ({ ...task, id: `davis-${task.id}`, assignee: 'Davis Ariel', progress: Math.max(5, task.progress - 20 + index * 7) })),
];
---

<AppLayout title="Kelola tugas" heading="Kelola tugas" description="Buat, tetapkan, dan arsipkan job desk tanpa mengubah progress milik karyawan." role="admin" user={user} activePath="/admin/tasks" isDemo={Astro.locals.isDemo}>
  <a slot="actions" class="button" href="/admin/tasks/new">Buat tugas baru</a>
  <section class="metrics-grid"><StatBlock label="Tugas aktif" value="9" helper="Untuk 3 karyawan" /><StatBlock label="Mendekati deadline" value="2" helper="Dalam 3 hari" trend="Perlu perhatian" tone="warning" /><StatBlock label="Dalam review" value="2" helper="Menunggu keputusan" trend="Review" /><StatBlock label="Selesai bulan ini" value="17" helper="Seluruh tim" trend="+21%" tone="success" /></section>
  <section class="panel task-admin-list"><div class="panel-header admin-toolbar"><div><h2>Semua tugas</h2><p>9 tugas aktif.</p></div><form><input class="input" type="search" placeholder="Cari judul atau karyawan..." aria-label="Cari tugas" /><select class="select" aria-label="Filter karyawan"><option>Semua karyawan</option><option>Joshua Wijaya</option><option>Airin Frantrishia Lay</option><option>Davis Ariel</option></select><select class="select" aria-label="Filter status"><option>Semua status</option><option>Dalam proses</option><option>Dalam review</option></select></form></div><div>{allTasks.map((task) => <TaskRow task={task} admin />)}</div></section>
</AppLayout>

<style>
  .task-admin-list { margin-top: 1rem; }
  .admin-toolbar { align-items: center; flex-wrap: wrap; }
  .admin-toolbar form { width: 100%; display: flex; flex-wrap: wrap; gap: .5rem; }
  .admin-toolbar .input { flex: 1 1 220px; }
  .admin-toolbar .select { flex: 0 1 180px; }
  @media (min-width: 980px) { .admin-toolbar form { width: auto; } }
</style>
