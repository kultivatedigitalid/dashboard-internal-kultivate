---
import { actions, isInputError } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import TaskFormFields from '@/components/TaskFormFields.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import ProgressBar from '@/components/ProgressBar.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData, taskEmployeeIds } from '@/lib/dashboard-data';
import { formatDate, formatDateTime } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const updateResult = Astro.getActionResult(actions.updateTask);
const deleteResult = Astro.getActionResult(actions.deleteTask);
if (deleteResult && !deleteResult.error) return Astro.redirect(deleteResult.data.redirectTo);
const fieldErrors = isInputError(updateResult?.error) ? updateResult.error.fields : {};
let loadError = '';
let data: Awaited<ReturnType<typeof loadDashboardData>> | undefined;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const taskId = Astro.params.taskId ?? '';
const task = data?.tasks.find((row) => row.id === taskId);
if (!task && !loadError) Astro.response.status = 404;
const employees = data?.profiles.filter((row) => row.role === 'employee' && row.is_active) ?? [];
const selectedEmployeeIds = data && task ? taskEmployeeIds(data, task.id) : [];
const assignees = employees.filter((row) => selectedEmployeeIds.includes(row.id));
const updatedBy = task?.progress_updated_by ? data?.profiles.find((row) => row.id === task.progress_updated_by)?.full_name : null;
const statusMeta = task?.status === 'completed' ? { label: 'Selesai', tone: 'success' as const } : task?.status === 'in_progress' ? { label: 'Proses', tone: 'info' as const } : { label: 'Belum Mulai', tone: 'neutral' as const };
const priorityMeta = task?.priority === 'urgent' ? { label: 'Urgent', tone: 'danger' as const } : { label: 'To-do', tone: 'neutral' as const };
---

<AppLayout title={task?.title ?? 'Tugas'} heading={task?.title ?? 'Tugas tidak ditemukan'} description="Atur detail, penugasan, deadline, dan pantau progress." role="admin" user={user} activePath="/admin/tasks">
  <a slot="actions" class="button secondary" href="/admin/tasks">Kembali</a>
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  {updateResult?.error && !isInputError(updateResult.error) && <div class="alert danger" role="alert">{updateResult.error.message}</div>}
  {updateResult?.error && isInputError(updateResult.error) && <div class="alert danger" role="alert">Periksa field yang ditandai lalu simpan kembali.</div>}
  {updateResult && !updateResult.error && <div class="alert success" role="status">{updateResult.data.message}</div>}
  {deleteResult?.error && <div class="alert danger" role="alert">{deleteResult.error.message}</div>}

  {!task ? <EmptyState title="Tugas tidak ditemukan" description="Tugas mungkin sudah dihapus." actionLabel="Kembali" actionHref="/admin/tasks" /> : (
    <div class="stack">
      <section class="task-monitor panel panel-body">
        <div class="monitor-main"><div class="cluster"><StatusBadge label={priorityMeta.label} tone={priorityMeta.tone} /><StatusBadge label={statusMeta.label} tone={statusMeta.tone} /></div><strong>{task.progress}%</strong><ProgressBar value={task.progress} /></div>
        <dl><div><dt>Karyawan</dt><dd>{assignees.map((row) => row.full_name).join(', ') || 'Belum ditugaskan'}</dd></div><div><dt>Deadline</dt><dd>{task.due_date ? formatDate(task.due_date) : 'No Deadline'}</dd></div><div><dt>Pembaruan terakhir</dt><dd>{task.progress_updated_at ? `${updatedBy ?? 'Pengguna'}, ${formatDateTime(task.progress_updated_at)}` : 'Belum ada pembaruan'}</dd></div></dl>
      </section>

      <form method="POST" action={actions.updateTask} class="stack">
        <input type="hidden" name="taskId" value={task.id} />
        <TaskFormFields employees={employees} task={task} selectedEmployeeIds={selectedEmployeeIds} includeProgress fieldErrors={fieldErrors} />
        <div class="form-actions"><button class="button danger-button" type="button" data-delete-open><i class="ph ph-trash" aria-hidden="true"></i>Hapus tugas</button><button class="button" type="submit"><i class="ph ph-floppy-disk" aria-hidden="true"></i>Simpan perubahan</button></div>
      </form>

      <dialog class="delete-dialog" data-delete-dialog aria-labelledby="delete-title">
        <div class="dialog-content"><span class="dialog-icon" aria-hidden="true"><i class="ph ph-warning"></i></span><div><h2 id="delete-title">Hapus tugas?</h2><p>Tugas <strong>{task.title}</strong> akan dihapus permanen untuk seluruh karyawan.</p></div></div>
        <div class="dialog-actions"><button class="button secondary" type="button" data-delete-cancel>Batal</button><form method="POST" action={actions.deleteTask}><input type="hidden" name="taskId" value={task.id} /><button class="button danger-button" type="submit">Ya, hapus tugas</button></form></div>
      </dialog>
    </div>
  )}

  <script>
    const deleteDialog = document.querySelector<HTMLDialogElement>('[data-delete-dialog]');
    document.querySelector('[data-delete-open]')?.addEventListener('click', () => deleteDialog?.showModal());
    document.querySelector('[data-delete-cancel]')?.addEventListener('click', () => deleteDialog?.close());
    deleteDialog?.addEventListener('click', (event) => { if (event.target === deleteDialog) deleteDialog.close(); });
  </script>
</AppLayout>

<style>
  .task-monitor{display:grid;gap:1rem}.monitor-main{display:grid;gap:.65rem}.monitor-main>strong{font-size:1.7rem}.task-monitor dl{display:grid;gap:.7rem;margin:0}.task-monitor dl div{display:grid;gap:.2rem}.task-monitor dt{color:var(--muted);font-size:.68rem}.task-monitor dd{margin:0;font-size:.8rem}.form-actions{display:flex;justify-content:space-between;gap:.7rem}.danger-button{background:var(--danger);color:white}.delete-dialog{width:min(460px,calc(100vw - 2rem));padding:1.1rem;border:0;border-radius:14px;box-shadow:var(--shadow-float)}.delete-dialog::backdrop{background:oklch(0.1 0 0/.55)}.dialog-content{display:flex;align-items:flex-start;gap:.8rem}.dialog-content p{margin-top:.4rem;color:var(--muted)}.dialog-icon{width:38px;height:38px;display:grid;place-items:center;flex:0 0 auto;border-radius:9px;background:var(--danger-soft);color:var(--danger);font-size:1.1rem}.dialog-actions{display:flex;justify-content:flex-end;gap:.6rem;margin-top:1.2rem}
  @media(min-width:800px){.task-monitor{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:center}.task-monitor dl{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>