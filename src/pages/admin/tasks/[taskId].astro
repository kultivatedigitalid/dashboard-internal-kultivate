---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData, employeeName } from '@/lib/dashboard-data';
import { formatDateTime } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.updateTask);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const taskId = Astro.params.taskId ?? '';
const task = data?.tasks.find((row) => row.id === taskId);
if (!task && !loadError) Astro.response.status = 404;
const employees = data?.profiles.filter((row) => row.role === 'employee' && row.is_active) ?? [];
const checklist = data?.checklist.filter((row) => row.task_id === taskId) ?? [];
const updates = data?.taskUpdates.filter((row) => row.task_id === taskId) ?? [];
---

<AppLayout title={task?.title ?? 'Tugas'} heading={task?.title ?? 'Tugas tidak ditemukan'} description="Edit definisi tugas dan pantau pembaruan karyawan." role="admin" user={user} activePath="/admin/tasks">
  <a slot="actions" class="button secondary" href="/admin/tasks">Kembali</a>
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  {!task ? <EmptyState title="Tugas tidak ditemukan" description="Tugas mungkin sudah dihapus." actionLabel="Kembali" actionHref="/admin/tasks" /> : (
    <div class="detail-grid">
      <form method="POST" action={actions.updateTask} class="panel panel-body stack">
        <input type="hidden" name="taskId" value={task.id} />
        <label class="field">Judul<input class="input" name="title" value={task.title} required /></label>
        <label class="field">Deskripsi<textarea class="textarea" name="description">{task.description ?? ''}</textarea></label>
        <label class="field">Karyawan<select class="select" name="assigneeId">{employees.map((row) => <option value={row.id} selected={task.assignee_id === row.id}>{row.full_name}</option>)}</select></label>
        <div class="split">
          <label class="field">Prioritas<select class="select" name="priority">{['low','medium','high','urgent'].map((value) => <option value={value} selected={task.priority === value}>{value}</option>)}</select></label>
          <label class="field">Status<select class="select" name="status">{['draft','not_started','in_progress','in_review','completed','archived'].map((value) => <option value={value} selected={task.status === value}>{value}</option>)}</select></label>
          <label class="field">Mulai<input class="input" name="startDate" type="date" value={task.start_date ?? ''} /></label>
          <label class="field">Deadline<input class="input" name="dueDate" type="date" value={task.due_date ?? ''} /></label>
          <label class="field">Estimasi<input class="input" name="estimateHours" type="number" min="0" step=".5" value={task.estimate_hours ?? 0} /></label>
        </div>
        <button class="button" type="submit">Simpan perubahan</button>
      </form>
      <aside class="stack">
        <section class="panel panel-body"><div class="cluster"><StatusBadge label={task.status} tone="info" /><StatusBadge label={task.priority} tone="warning" /></div><h2>{employeeName(data!, task.assignee_id)}</h2><p>Progres <strong>{task.progress}%</strong> · {checklist.filter((row) => row.is_done).length}/{checklist.length} checklist.</p></section>
        <section class="panel"><div class="panel-header"><div><h2>Riwayat progres</h2></div></div>{updates.length ? <div>{updates.map((row) => <article class="update"><div><strong>{row.progress}%</strong><small>{formatDateTime(row.created_at)}</small></div>{row.note && <p>{row.note}</p>}{row.work_url && <a href={row.work_url} target="_blank" rel="noreferrer">Buka hasil ↗</a>}</article>)}</div> : <EmptyState title="Belum ada pembaruan" description="Karyawan belum menyimpan progres." />}</section>
      </aside>
    </div>
  )}
</AppLayout>

<style>.detail-grid{display:grid;gap:1rem}.split{display:grid;gap:1rem}.update{padding:1rem;border-bottom:1px solid var(--line)}.update>div{display:flex;justify-content:space-between}.update small,.update p{color:var(--muted)}.update a{color:var(--primary)}@media(min-width:760px){.split{grid-template-columns:1fr 1fr}}@media(min-width:960px){.detail-grid{grid-template-columns:1.2fr .8fr}}</style>
