---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { adminUser, employeeTasks } from '@/lib/demo-data';
const user = Astro.locals.user ?? adminUser;
const task = employeeTasks.find((item) => item.id === Astro.params.taskId) ?? employeeTasks[0];
if (!task) return Astro.redirect('/admin/tasks');
---

<AppLayout title={task.title} heading={task.title} description={`${task.assignee} · deadline 23 Jul 2026`} role="admin" user={user} activePath={`/admin/tasks/${task.id}`} isDemo={Astro.locals.isDemo}>
  <a slot="actions" class="button secondary" href="/admin/tasks">Kembali</a><button slot="actions" class="button" type="button">Edit tugas</button>
  <section class="panel"><div class="panel-body stack"><div class="cluster"><StatusBadge label="Dalam proses" tone="info" /><StatusBadge label="Prioritas tinggi" tone="warning" /></div><h2>Detail dan progres tugas</h2><p style="color:var(--muted);max-width:70ch">Persiapkan seluruh akses dan perangkat kerja. Definisi tugas hanya dapat diubah admin, sementara karyawan memperbarui checklist dan progress.</p><a class="text-link" href={`/admin/employees/${task.assignee.split(' ')[0].toLowerCase()}`}>Lihat profil {task.assignee} →</a></div></section>
</AppLayout>
