---
import { actions, isInputError } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import TaskFormFields from '@/components/TaskFormFields.astro';
import { loadDashboardData } from '@/lib/dashboard-data';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.createTask);
if (result && !result.error) return Astro.redirect(result.data.redirectTo);
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
let loadError = '';
let data: Awaited<ReturnType<typeof loadDashboardData>> | undefined;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employees = data?.profiles.filter((row) => row.role === 'employee' && row.is_active) ?? [];
---

<AppLayout title="Tugas baru" heading="Buat tugas" description="Tetapkan pekerjaan, penanggung jawab, priority, dan deadline." role="admin" user={user} activePath="/admin/tasks">
  <a slot="actions" class="button secondary" href="/admin/tasks">Batal</a>
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  {result?.error && !isInputError(result.error) && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result?.error && isInputError(result.error) && <div class="alert danger" role="alert">Periksa field yang ditandai lalu kirim kembali.</div>}
  <form method="POST" action={actions.createTask} class="stack">
    <TaskFormFields employees={employees} fieldErrors={fieldErrors} />
    <div class="form-actions"><a class="button secondary" href="/admin/tasks">Batal</a><button class="button" type="submit" disabled={!employees.length}><i class="ph ph-plus" aria-hidden="true"></i>Buat tugas</button></div>
  </form>
</AppLayout>

<style>.form-actions{display:flex;justify-content:flex-end;gap:.65rem;padding-top:.25rem}</style>