---
import { actions, isInputError } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData } from '@/lib/dashboard-data';
import { formatDate } from '@/lib/formatters';
import { netHours } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.createEmployee);
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const errorText = (key: string) => fieldErrors[key]?.join(', ');
let loadError = '';
let data: Awaited<ReturnType<typeof loadDashboardData>> | undefined;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const params = Astro.url.searchParams;
const name = params.get('name')?.trim().toLowerCase() ?? '';
const email = params.get('email')?.trim().toLowerCase() ?? '';
const code = params.get('code')?.trim().toLowerCase() ?? '';
const state = params.get('state') ?? '';
const joinedAfter = params.get('joinedAfter') ?? '';
const minHoursValue = params.get('minHours') ?? '';
const maxHoursValue = params.get('maxHours') ?? '';
const minHours = minHoursValue === '' ? null : Number(minHoursValue);
const maxHours = maxHoursValue === '' ? null : Number(maxHoursValue);
const hours = (id: string) => (data?.sessions ?? []).filter((row) => row.employee_id === id && row.status === 'approved').reduce((sum, row) => sum + netHours(row.check_in, row.check_out, row.break_minutes), 0);
const employees = (data?.profiles ?? []).filter((row) => {
  if (row.role !== 'employee') return false;
  const approvedHours = hours(row.id);
  return (!name || row.full_name.toLowerCase().includes(name))
    && (!email || row.email.toLowerCase().includes(email))
    && (!code || row.employee_code?.toLowerCase().includes(code))
    && (!state || String(row.is_active) === state)
    && (!joinedAfter || row.joined_at.slice(0, 10) >= joinedAfter)
    && (minHours === null || !Number.isFinite(minHours) || approvedHours >= minHours)
    && (maxHours === null || !Number.isFinite(maxHours) || approvedHours <= maxHours);
});
const hasFilters = ['name','email','code','state','joinedAfter','minHours','maxHours'].some((key) => params.has(key) && params.get(key));
---

<AppLayout title="Karyawan" heading="Karyawan" description="Tambah akun karyawan dan filter direktori berdasarkan setiap informasi karyawan." role="admin" user={user} activePath="/admin/employees">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && !isInputError(result.error) && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result?.error && isInputError(result.error) && <div class="alert danger" role="alert">Periksa Nama dan Gmail yang ditandai lalu coba lagi.</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}

  <section class="panel invite"><div class="panel-header"><div><h2>Tambah karyawan</h2><p>Akun, profil, role karyawan, dan akses penerima tugas akan dibuat langsung di Supabase.</p></div></div><form method="POST" action={actions.createEmployee} class="panel-body invite-fields"><label class="field"><span class="field-label">Nama lengkap <span class="required-mark" aria-hidden="true">*</span></span><input class="input" name="fullName" minlength="2" maxlength="120" autocomplete="name" required aria-invalid={Boolean(errorText('fullName'))} />{errorText('fullName') && <span class="field-error">{errorText('fullName')}</span>}</label><label class="field"><span class="field-label">Gmail <span class="required-mark" aria-hidden="true">*</span></span><input class="input" name="email" type="email" inputmode="email" autocomplete="email" pattern="[A-Za-z0-9._%+-]+@gmail\.com" title="Masukkan alamat Gmail yang valid." required aria-invalid={Boolean(errorText('email'))} />{errorText('email') && <span class="field-error">{errorText('email')}</span>}</label><p class="field-hint">Password awal dibuat otomatis dengan format <code>password123&lt;nama_depan&gt;</code>.</p><button class="button" type="submit">Tambah karyawan</button></form></section>

  <section class="panel directory">
    <div class="panel-header"><div><h2>Direktori karyawan</h2><p>{employees.length} karyawan sesuai filter.</p></div>{hasFilters && <a class="text-link" href="/admin/employees">Reset filter</a>}</div>
    <form method="GET" class="panel-body filters">
      <label class="field">Nama<input class="input" name="name" value={params.get('name') ?? ''} placeholder="Cari nama" /></label>
      <label class="field">Email<input class="input" name="email" value={params.get('email') ?? ''} placeholder="Cari email" /></label>
      <label class="field">Kode karyawan<input class="input" name="code" value={params.get('code') ?? ''} placeholder="Cari kode" /></label>
      <label class="field">Status<select class="select" name="state"><option value="">Semua status</option><option value="true" selected={state === 'true'}>Aktif</option><option value="false" selected={state === 'false'}>Nonaktif</option></select></label>
      <label class="field">Bergabung setelah<input class="input" type="date" name="joinedAfter" value={joinedAfter} /></label>
      <label class="field">Jam minimum<input class="input" type="number" min="0" step=".5" name="minHours" value={params.get('minHours') ?? ''} /></label>
      <label class="field">Jam maksimum<input class="input" type="number" min="0" step=".5" name="maxHours" value={params.get('maxHours') ?? ''} /></label>
      <button class="button" type="submit"><i class="ph ph-funnel" aria-hidden="true"></i>Terapkan filter</button>
    </form>
    {employees.length ? <div class="employee-grid">{employees.map((employee) => <article><div><span class="avatar">{employee.full_name.split(' ').filter(Boolean).slice(0,2).map((part) => part[0]).join('')}</span><StatusBadge label={employee.is_active ? 'Aktif' : 'Nonaktif'} tone={employee.is_active ? 'success' : 'danger'} /></div><h3>{employee.full_name}</h3><dl><div><dt>Email</dt><dd>{employee.email}</dd></div><div><dt>Kode</dt><dd>{employee.employee_code ?? 'Tanpa kode'}</dd></div><div><dt>Bergabung</dt><dd>{formatDate(employee.joined_at)}</dd></div><div><dt>Jam disetujui</dt><dd>{hours(employee.id).toFixed(1)} jam</dd></div></dl><a class="button secondary" href={`/admin/employees/${employee.id}`}>Buka profil</a></article>)}</div> : <EmptyState title="Karyawan tidak ditemukan" description="Tambahkan karyawan baru atau ubah filter." />}
  </section>
</AppLayout>

<style>.invite,.directory{margin-bottom:1rem}.invite-fields,.filters{display:grid;gap:.75rem}.filters .button,.invite-fields .button{align-self:end}.employee-grid{display:grid;gap:1px;background:var(--line)}.employee-grid article{display:grid;gap:.75rem;padding:1.1rem;background:white}.employee-grid article>div:first-child{display:flex;justify-content:space-between}.employee-grid h3{font-size:.95rem}.employee-grid dl{display:grid;gap:.55rem;margin:0}.employee-grid dl div{display:grid;gap:.15rem}.employee-grid dt{color:var(--muted);font-size:.65rem}.employee-grid dd{margin:0;overflow-wrap:anywhere;font-size:.76rem}.employee-grid .button{margin-top:.25rem}@media(min-width:760px){.invite-fields{grid-template-columns:1fr 1fr 1fr auto}.filters{grid-template-columns:repeat(2,minmax(0,1fr))}.employee-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1100px){.filters{grid-template-columns:repeat(4,minmax(0,1fr))}.filters .button{grid-column:4}.employee-grid{grid-template-columns:repeat(3,1fr)}}</style>