---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData } from '@/lib/dashboard-data';
import { netHours } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.inviteEmployee);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const q = Astro.url.searchParams.get('q')?.toLowerCase() ?? '';
const state = Astro.url.searchParams.get('state') ?? '';
const employees = (data?.profiles ?? []).filter((row) => row.role === 'employee' && (!q || row.full_name.toLowerCase().includes(q) || row.email.toLowerCase().includes(q) || row.employee_code?.toLowerCase().includes(q)) && (!state || String(row.is_active) === state));
const hours = (id: string) => (data?.sessions ?? []).filter((row) => row.employee_id === id && row.status === 'approved').reduce((sum, row) => sum + netHours(row.check_in, row.check_out, row.break_minutes), 0);
---

<AppLayout title="Karyawan" heading="Karyawan" description="Undang akun baru dan pantau status anggota tim." role="admin" user={user} activePath="/admin/employees">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}

  <section class="panel invite">
    <div class="panel-header"><div><h2>Undang karyawan</h2><p>Supabase akan mengirim email untuk membuat password.</p></div></div>
    <form method="POST" action={actions.inviteEmployee} class="panel-body invite-fields">
      <label class="field">Nama lengkap<input class="input" name="fullName" required /></label>
      <label class="field">Email<input class="input" name="email" type="email" required /></label>
      <label class="field">Kode karyawan<input class="input" name="employeeCode" required /></label>
      <button class="button" type="submit">Kirim undangan</button>
    </form>
  </section>

  <section class="panel directory">
    <div class="panel-header">
      <form method="GET" class="filters"><input class="input" name="q" value={q} placeholder="Cari karyawan..." /><select class="select" name="state"><option value="">Semua status</option><option value="true" selected={state === 'true'}>Aktif</option><option value="false" selected={state === 'false'}>Nonaktif</option></select><button class="button secondary">Terapkan</button></form>
    </div>
    {employees.length ? <div class="employee-grid">{employees.map((employee) => <article><div><span class="avatar">{employee.full_name.split(' ').slice(0,2).map((p) => p[0]).join('')}</span><StatusBadge label={employee.is_active ? 'Aktif' : 'Nonaktif'} tone={employee.is_active ? 'success' : 'danger'} /></div><h3>{employee.full_name}</h3><p>{employee.employee_code ?? 'Tanpa kode'} · {employee.email}</p><strong>{hours(employee.id).toFixed(1)} jam disetujui</strong><a class="button secondary" href={`/admin/employees/${employee.id}`}>Buka profil</a></article>)}</div> : <EmptyState title="Karyawan tidak ditemukan" description="Undang karyawan baru atau ubah filter." />}
  </section>
</AppLayout>

<style>.invite,.directory{margin-bottom:1rem}.invite-fields,.filters{display:grid;gap:.7rem}.employee-grid{display:grid;gap:1px;background:var(--line)}.employee-grid article{display:grid;gap:.6rem;padding:1.1rem;background:white}.employee-grid article>div{display:flex;justify-content:space-between}.employee-grid p{color:var(--muted);font-size:.78rem}.employee-grid .button{margin-top:.4rem}@media(min-width:760px){.invite-fields{grid-template-columns:1fr 1fr 1fr auto;align-items:end}.filters{grid-template-columns:1fr 220px auto}.employee-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1100px){.employee-grid{grid-template-columns:repeat(3,1fr)}}</style>
