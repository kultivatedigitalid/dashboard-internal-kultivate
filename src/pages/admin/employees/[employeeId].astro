---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import TaskRow from '@/components/TaskRow.astro';
import { loadDashboardData, toDashboardTask } from '@/lib/dashboard-data';
import { formatDate } from '@/lib/formatters';
import { netHours } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.setEmployeeActive);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employeeId = Astro.params.employeeId ?? '';
const employee = data?.profiles.find((row) => row.id === employeeId && row.role === 'employee');
if (!employee && !loadError) Astro.response.status = 404;
const sessions = data?.sessions.filter((row) => row.employee_id === employeeId) ?? [];
const approvedHours = sessions.filter((row) => row.status === 'approved').reduce((sum, row) => sum + netHours(row.check_in, row.check_out, row.break_minutes), 0);
const tasks = data?.tasks.filter((row) => row.assignee_id === employeeId) ?? [];
const reports = data?.reports.filter((row) => row.employee_id === employeeId) ?? [];
const evaluations = data?.evaluations.filter((row) => row.employee_id === employeeId) ?? [];
---

<AppLayout title={employee?.full_name ?? 'Karyawan'} heading={employee?.full_name ?? 'Karyawan tidak ditemukan'} description="Profil, progres, dan status akun karyawan." role="admin" user={user} activePath="/admin/employees">
  <a slot="actions" class="button secondary" href="/admin/employees">Kembali</a>
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  {!employee ? <EmptyState title="Karyawan tidak ditemukan" description="Akun mungkin sudah dihapus." actionLabel="Kembali" actionHref="/admin/employees" /> : (
    <div class="detail-grid">
      <aside class="panel panel-body stack">
        <span class="avatar large">{employee.full_name.split(' ').slice(0,2).map((p) => p[0]).join('')}</span>
        <h2>{employee.full_name}</h2>
        <p>{employee.email}<br />{employee.employee_code ?? 'Tanpa kode'}</p>
        <StatusBadge label={employee.is_active ? 'Aktif' : 'Nonaktif'} tone={employee.is_active ? 'success' : 'danger'} />
        <dl><div><dt>Bergabung</dt><dd>{formatDate(employee.joined_at)}</dd></div><div><dt>Jam disetujui</dt><dd>{approvedHours.toFixed(1)}</dd></div><div><dt>Laporan</dt><dd>{reports.length}</dd></div></dl>
        <form method="POST" action={actions.setEmployeeActive}><input type="hidden" name="employeeId" value={employee.id} /><input type="hidden" name="active" value={String(!employee.is_active)} /><button class:list={['button', employee.is_active ? 'secondary' : '']} type="submit">{employee.is_active ? 'Nonaktifkan akun' : 'Aktifkan akun'}</button></form>
        <a class="button secondary" href={`/admin/evaluations?employee=${employee.id}`}>Buat evaluasi</a>
      </aside>
      <div class="stack">
        <section class="panel"><div class="panel-header"><div><h2>Tugas</h2></div></div>{tasks.length && data ? tasks.map((task) => <TaskRow task={toDashboardTask(task, data)} admin />) : <EmptyState title="Belum ada tugas" description="Buat tugas untuk karyawan ini." actionLabel="Buat tugas" actionHref="/admin/tasks/new" />}</section>
        <section class="panel"><div class="panel-header"><div><h2>Evaluasi</h2></div></div>{evaluations.length ? <div>{evaluations.map((item) => <article class="row"><strong>{item.title}</strong><StatusBadge label={item.is_published ? 'Published' : 'Draft'} tone={item.is_published ? 'success' : 'neutral'} /><p>{item.notes}</p></article>)}</div> : <EmptyState title="Belum ada evaluasi" description="Evaluasi baru akan muncul di sini." />}</section>
      </div>
    </div>
  )}
</AppLayout>

<style>.detail-grid{display:grid;gap:1rem}.panel-body p{color:var(--muted)}dl{display:grid;gap:.6rem}dl div{display:flex;justify-content:space-between}dd{margin:0}.row{display:grid;grid-template-columns:1fr auto;gap:.6rem;padding:1rem;border-bottom:1px solid var(--line)}.row p{grid-column:1/-1;color:var(--muted)}@media(min-width:900px){.detail-grid{grid-template-columns:320px 1fr}}</style>
