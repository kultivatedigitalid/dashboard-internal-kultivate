---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import ProgressBar from '@/components/ProgressBar.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData } from '@/lib/dashboard-data';
import { calculateProgress } from '@/lib/formatters';
import { currentWeekStart, netHours } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.upsertTarget);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const employees = data?.profiles.filter((row) => row.role === 'employee' && row.is_active) ?? [];
const approvedHours = (id: string) => (data?.sessions ?? []).filter((row) => row.employee_id === id && row.status === 'approved').reduce((sum, row) => sum + netHours(row.check_in, row.check_out, row.break_minutes), 0);
const targetFor = (id: string) => data?.targets.find((row) => row.employee_id === id && row.target_type === 'overall');
---

<AppLayout title="Target" heading="Target kerja" description="Tetapkan target keseluruhan, mingguan, atau bulanan per karyawan." role="admin" user={user} activePath="/admin/targets">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  <section class="panel">
    <div class="panel-header"><div><h2>Target baru</h2><p>Target sebelumnya pada tipe yang sama akan dinonaktifkan.</p></div></div>
    <form method="POST" action={actions.upsertTarget} class="panel-body target-form">
      <label class="field">Karyawan<select class="select" name="employeeId" required><option value="">Pilih karyawan</option>{employees.map((row) => <option value={row.id}>{row.full_name}</option>)}</select></label>
      <label class="field">Jenis<select class="select" name="targetType"><option value="overall">Keseluruhan</option><option value="weekly">Mingguan</option><option value="monthly">Bulanan</option></select></label>
      <label class="field">Jam<input class="input" name="targetHours" type="number" min="0" step=".5" value={data?.settings.overall_target_hours ?? 600} required /></label>
      <label class="field">Mulai<input class="input" name="periodStart" type="date" value={currentWeekStart()} /></label>
      <label class="field">Selesai<input class="input" name="periodEnd" type="date" /></label>
      <button class="button" type="submit">Simpan target</button>
    </form>
  </section>
  <section class="panel list">
    <div class="panel-header"><div><h2>Target keseluruhan aktif</h2></div></div>
    {employees.length ? <div>{employees.map((employee) => { const target = targetFor(employee.id); const actual = approvedHours(employee.id); const targetHours = target?.target_hours ?? data?.settings.overall_target_hours ?? 600; return <article class="target-row"><div><strong>{employee.full_name}</strong><span>{employee.employee_code ?? 'Tanpa kode'}</span></div><div><span>{actual.toFixed(1)} / {targetHours} jam</span><ProgressBar value={calculateProgress(actual, targetHours)} /></div></article>; })}</div> : <EmptyState title="Belum ada karyawan" description="Undang karyawan sebelum membuat target." actionLabel="Kelola karyawan" actionHref="/admin/employees" />}
  </section>
</AppLayout>

<style>.target-form{display:grid;gap:.7rem}.list{margin-top:1rem}.target-row{display:grid;gap:1rem;padding:1rem;border-bottom:1px solid var(--line)}.target-row>div{display:grid;gap:.4rem}.target-row span{color:var(--muted);font-size:.75rem}@media(min-width:900px){.target-form{grid-template-columns:repeat(5,1fr) auto;align-items:end}.target-row{grid-template-columns:260px 1fr}}</style>
