---
import { actions, isInputError } from 'astro:actions';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';

const result = Astro.getActionResult(actions.resetPassword);
if (result && !result.error) return Astro.redirect(result.data.redirectTo);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const hasRecoverySession = Boolean(Astro.locals.user);
---

<BaseLayout title="Password baru" bodyClass="simple-auth">
  <main class="simple-auth-shell">
    <Logo />
    <section class="simple-auth-card">
      <h1>Buat password baru</h1>
      <p>Gunakan minimal 8 karakter dan hindari password yang pernah dipakai.</p>
      {!hasRecoverySession ? (
        <div class="alert danger" role="alert">
          Sesi pemulihan tidak tersedia atau sudah kedaluwarsa. <a href="/forgot-password">Minta tautan baru.</a>
        </div>
      ) : (
        <>
          {result?.error && <div class="alert danger" role="alert">{result.error.message}</div>}
          <form method="POST" action={actions.resetPassword} class="stack">
            <div class="field">
              <label for="password">Password baru <span class="required-mark" aria-hidden="true">*</span></label>
              <input class="input" id="password" name="password" type="password" minlength="8" autocomplete="new-password" required />
              {inputErrors.password && <span class="field-error">{inputErrors.password.join(', ')}</span>}
            </div>
            <div class="field">
              <label for="confirm">Ulangi password <span class="required-mark" aria-hidden="true">*</span></label>
              <input class="input" id="confirm" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required />
              {inputErrors.confirmPassword && <span class="field-error">{inputErrors.confirmPassword.join(', ')}</span>}
            </div>
            <button class="button" type="submit">Simpan password</button>
          </form>
        </>
      )}
    </section>
  </main>
</BaseLayout>
