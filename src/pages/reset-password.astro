---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
---

<BaseLayout title="Password baru" bodyClass="simple-auth">
  <main class="simple-auth-shell">
    <Logo />
    <section class="simple-auth-card">
      <h1>Buat password baru</h1>
      <p>Gunakan minimal 8 karakter dan hindari password yang pernah dipakai.</p>
      <form class="stack">
        <div class="field"><label for="password">Password baru</label><input class="input" id="password" type="password" minlength="8" autocomplete="new-password" required /></div>
        <div class="field"><label for="confirm">Ulangi password</label><input class="input" id="confirm" type="password" minlength="8" autocomplete="new-password" required /></div>
        <button class="button" type="submit">Simpan password</button>
      </form>
    </section>
  </main>
</BaseLayout>
