---
import AppLayout from '@/layouts/AppLayout.astro';
import TaskRow from '@/components/TaskRow.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData, toDashboardTask } from '@/lib/dashboard-data';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const q = Astro.url.searchParams.get('q')?.toLowerCase() ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const tasks = (data?.tasks ?? []).filter((task) => (!q || task.title.toLowerCase().includes(q)) && (!status || task.status === status));
---

<AppLayout title="Tugas" heading="Tugas saya" description="Perbarui checklist, progres, tautan, dan bukti kerja." role="employee" user={user} activePath="/app/tasks">
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  <section class="panel">
    <div class="panel-header">
      <form method="GET" class="filters">
        <input class="input" name="q" type="search" value={q} placeholder="Cari tugas..." />
        <select class="select" name="status">
          <option value="">Semua status</option>
          <option value="not_started" selected={status === 'not_started'}>Belum dimulai</option>
          <option value="in_progress" selected={status === 'in_progress'}>Dalam proses</option>
          <option value="in_review" selected={status === 'in_review'}>Dalam review</option>
          <option value="completed" selected={status === 'completed'}>Selesai</option>
        </select>
        <button class="button secondary" type="submit">Terapkan</button>
      </form>
    </div>
    {tasks.length && data ? tasks.map((task) => <TaskRow task={toDashboardTask(task, data)} />) : <EmptyState title="Tidak ada tugas" description="Belum ada tugas yang cocok dengan filter." />}
  </section>
</AppLayout>

<style>.filters{width:100%;display:grid;gap:.6rem}@media(min-width:700px){.filters{grid-template-columns:1fr 220px auto}}</style>
