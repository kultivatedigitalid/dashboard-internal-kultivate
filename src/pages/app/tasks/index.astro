---
import AppLayout from '@/layouts/AppLayout.astro';
import TaskTable from '@/components/TaskTable.astro';
import { loadDashboardData, toDashboardTask } from '@/lib/dashboard-data';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
let loadError = '';
let data: Awaited<ReturnType<typeof loadDashboardData>> | undefined;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }

const params = Astro.url.searchParams;
const filters = {
  q: params.get('q')?.trim().toLowerCase() ?? '',
  priority: params.get('priority') ?? '',
  employee: params.get('employee')?.trim().toLowerCase() ?? '',
  task: params.get('task')?.trim().toLowerCase() ?? '',
  status: params.get('status') ?? '',
};
const priorityLabels = { urgent: 'urgent', todo: 'to-do' } as const;
const statusLabels = { not_started: 'belum mulai', in_progress: 'proses', completed: 'selesai' } as const;
const allTasks = data ? data.tasks.map((task) => toDashboardTask(task, data!)) : [];
const priorityRank = { urgent: 0, todo: 1 } as const;
const tasks = allTasks.filter((task) => {
  const employees = task.assignees.join(', ').toLowerCase();
  const searchable = [task.title, task.projectDescription, employees, priorityLabels[task.priority], statusLabels[task.status]].join(' ').toLowerCase();
  return (!filters.q || searchable.includes(filters.q))
    && (!filters.priority || task.priority === filters.priority)
    && (!filters.employee || employees.includes(filters.employee))
    && (!filters.task || task.title.toLowerCase().includes(filters.task))
    && (!filters.status || task.status === filters.status);
}).sort((a, b) => priorityRank[a.priority] - priorityRank[b.priority] || a.title.localeCompare(b.title));
const hasFilters = Object.values(filters).some(Boolean);
---

<AppLayout title="Tugas" heading="Tugas" description="Lihat detail tugas dan perbarui progress pekerjaan Anda." role="employee" user={user} activePath="/app/tasks">
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  {params.get('updated') === 'success' && <div class="alert success" role="status">Progress berhasil diperbarui.</div>}
  <TaskTable tasks={tasks} searchPath="/app/tasks" filters={filters} hasFilters={hasFilters} />
</AppLayout>