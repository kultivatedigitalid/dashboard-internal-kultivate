---
import AppLayout from '@/layouts/AppLayout.astro';
import ProgressBar from '@/components/ProgressBar.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { employeeTasks, employeeUser } from '@/lib/demo-data';
import { formatDate } from '@/lib/formatters';

const user = Astro.locals.user ?? employeeUser;
const task = employeeTasks.find((item) => item.id === Astro.params.taskId) ?? employeeTasks[0];
if (!task) return Astro.redirect('/app/tasks');
const checklist = [
  { label: 'Membaca panduan kerja', done: true },
  { label: 'Menyiapkan akun dan tools', done: true },
  { label: 'Memastikan akses repository', done: true },
  { label: 'Membuat catatan setup', done: true },
  { label: 'Mengirim bukti setup', done: false },
];
---

<AppLayout title={task.title} heading={task.title} description={`Deadline ${formatDate(task.dueDate)} · Ditugaskan kepada ${task.assignee}`} role="employee" user={user} activePath={`/app/tasks/${task.id}`} isDemo={Astro.locals.isDemo}>
  <a slot="actions" class="button secondary" href="/app/tasks">Kembali ke tugas</a>

  <div class="task-detail-grid">
    <section class="task-detail-main">
      <div class="panel task-overview">
        <div class="overview-status"><StatusBadge label="Sedang dikerjakan" tone="info" /><StatusBadge label="Prioritas tinggi" tone="warning" /></div>
        <h2>Persiapkan seluruh akses dan perangkat kerja agar aktivitas tim dapat dimulai tanpa hambatan.</h2>
        <div class="detail-meta"><div><span>Tanggal mulai</span><strong>20 Jul 2026</strong></div><div><span>Deadline</span><strong>{formatDate(task.dueDate)}</strong></div><div><span>Estimasi</span><strong>12 jam</strong></div></div>
      </div>

      <section class="panel checklist-panel">
        <div class="panel-header"><div><h2>Checklist tugas</h2><p>{task.checklistDone} dari {task.checklistTotal} item selesai.</p></div><strong>{task.progress}%</strong></div>
        <div class="checklist">
          {checklist.map((item, index) => <label class:list={['check-item', { done: item.done }]}><input type="checkbox" checked={item.done} /><span class="custom-check" aria-hidden="true">{item.done ? '✓' : ''}</span><span>{item.label}</span><small>Langkah {index + 1}</small></label>)}
        </div>
      </section>

      <section class="panel evidence-panel">
        <div class="panel-header"><div><h2>Bukti pekerjaan</h2><p>PDF, JPEG, PNG, atau WebP hingga 10 MB.</p></div></div>
        <div class="upload-zone"><strong>Letakkan file di sini</strong><span>atau pilih dari perangkat Anda</span><button class="button secondary" type="button">Pilih file</button></div>
      </section>
    </section>

    <aside class="task-side">
      <section class="panel progress-editor">
        <div class="panel-header"><div><h2>Perbarui progres</h2><p>Perubahan hanya berlaku pada progres Anda.</p></div></div>
        <form class="panel-body stack">
          <ProgressBar value={task.progress} label="Progres saat ini" showValue />
          <div class="field"><label for="status">Status</label><select class="select" id="status"><option>Dalam proses</option><option>Dalam review</option><option>Selesai</option></select></div>
          <div class="field"><label for="progress-note">Catatan progres</label><textarea class="textarea" id="progress-note" placeholder="Apa yang sudah dikerjakan?"></textarea></div>
          <button class="button" type="submit">Simpan progres</button>
        </form>
      </section>
      <section class="panel link-panel"><div class="panel-body"><h2>Tautan hasil</h2><p>Tambahkan GitHub, Drive, Figma, atau website.</p><div class="field"><label for="work-link">URL pekerjaan</label><input class="input" id="work-link" type="url" placeholder="https://" /></div><button class="button secondary" type="button">Tambahkan tautan</button></div></section>
    </aside>
  </div>
</AppLayout>

<style>
  .task-detail-grid { display: grid; gap: 1rem; }
  .task-detail-main, .task-side { display: grid; gap: 1rem; align-content: start; }
  .task-overview { padding: 1.25rem; }
  .overview-status { display: flex; flex-wrap: wrap; gap: .45rem; }
  .task-overview h2 { max-width: 62ch; margin: 1rem 0 1.4rem; font-size: 1.05rem; font-weight: 620; line-height: 1.55; }
  .detail-meta { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .detail-meta div { display: grid; }
  .detail-meta span { color: var(--muted); font-size: .7rem; }
  .detail-meta strong { margin-top: .15rem; font-size: .8rem; }
  .checklist-panel .panel-header > strong { color: var(--primary); }
  .checklist { display: grid; }
  .check-item { min-height: 62px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; padding: .8rem 1.2rem; border-bottom: 1px solid var(--line); cursor: pointer; }
  .check-item:last-child { border-bottom: 0; }
  .check-item input { position: absolute; opacity: 0; }
  .custom-check { width: 24px; height: 24px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 7px; color: white; }
  .check-item.done .custom-check { border-color: var(--primary); background: var(--primary); }
  .check-item.done > span:nth-of-type(2) { color: var(--muted); text-decoration: line-through; }
  .check-item small { color: var(--muted); font-size: .68rem; }
  .upload-zone { min-height: 220px; display: grid; place-items: center; align-content: center; gap: .3rem; margin: 1rem; padding: 1.5rem; border: 1px dashed var(--line-strong); border-radius: 10px; background: var(--surface); text-align: center; }
  .upload-zone strong { font-size: .88rem; }
  .upload-zone span { margin-bottom: .7rem; color: var(--muted); font-size: .75rem; }
  .link-panel h2 { font-size: 1rem; }
  .link-panel p { margin: .35rem 0 1rem; color: var(--muted); font-size: .78rem; }
  .link-panel .button { width: 100%; margin-top: .8rem; }
  @media (min-width: 1050px) { .task-detail-grid { grid-template-columns: minmax(0, 1.45fr) minmax(320px, .55fr); } }
</style>
