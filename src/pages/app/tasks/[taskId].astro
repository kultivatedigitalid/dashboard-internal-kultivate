---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { createEvidenceUrl, loadDashboardData } from '@/lib/dashboard-data';
import { formatDate, formatDateTime } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const taskId = Astro.params.taskId ?? '';
const task = data?.tasks.find((row) => row.id === taskId);
if (!task && !loadError) Astro.response.status = 404;
const checklist = data?.checklist.filter((row) => row.task_id === taskId) ?? [];
const updates = data?.taskUpdates.filter((row) => row.task_id === taskId) ?? [];
const evidenceUrls = new Map<string, string>();
for (const update of updates) {
  if (update.evidence_path) {
    const url = await createEvidenceUrl(Astro, update.evidence_path);
    if (url) evidenceUrls.set(update.id, url);
  }
}
const results = [
  Astro.getActionResult(actions.updateTaskProgress),
  Astro.getActionResult(actions.toggleChecklist),
  Astro.getActionResult(actions.uploadTaskEvidence),
].filter(Boolean);
---

<AppLayout title={task?.title ?? 'Tugas'} heading={task?.title ?? 'Tugas tidak ditemukan'} description="Perbarui progres dan lampirkan hasil pekerjaan." role="employee" user={user} activePath="/app/tasks">
  <a slot="actions" class="button secondary" href="/app/tasks">Kembali</a>
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  {results.map((result) => result?.error ? <div class="alert danger" role="alert">{result.error.message}</div> : <div class="alert success">{result?.data.message}</div>)}

  {!task ? <EmptyState title="Tugas tidak ditemukan" description="Tugas mungkin sudah dihapus atau tidak ditugaskan kepada Anda." actionLabel="Kembali ke tugas" actionHref="/app/tasks" /> : (
    <div class="task-grid">
      <div class="stack">
        <section class="panel panel-body">
          <div class="cluster"><StatusBadge label={task.status} tone="info" /><StatusBadge label={task.priority} tone={task.priority === 'urgent' ? 'danger' : 'warning'} /></div>
          <p>{task.description || 'Tidak ada deskripsi.'}</p>
          <dl class="facts"><div><dt>Mulai</dt><dd>{task.start_date ? formatDate(task.start_date) : '—'}</dd></div><div><dt>Deadline</dt><dd>{task.due_date ? formatDate(task.due_date) : '—'}</dd></div><div><dt>Estimasi</dt><dd>{task.estimate_hours ?? 0} jam</dd></div></dl>
        </section>

        <section class="panel">
          <div class="panel-header"><div><h2>Checklist</h2><p>{checklist.filter((item) => item.is_done).length} dari {checklist.length} selesai.</p></div></div>
          {checklist.length ? <div class="checklist">{checklist.map((item) => <form method="POST" action={actions.toggleChecklist}><input type="hidden" name="itemId" value={item.id} /><input type="hidden" name="isDone" value={String(!item.is_done)} /><button class:list={['check-item', { done: item.is_done }]} type="submit"><span>{item.is_done ? '✓' : ''}</span>{item.title}</button></form>)}</div> : <EmptyState title="Belum ada checklist" description="Admin tidak menambahkan checklist pada tugas ini." />}
        </section>

        <section class="panel">
          <div class="panel-header"><div><h2>Riwayat progres</h2><p>Catatan, link, dan bukti terbaru.</p></div></div>
          {updates.length ? <div class="updates">{updates.map((update) => <article><div><strong>{update.progress}%</strong><span>{formatDateTime(update.created_at)}</span></div>{update.note && <p>{update.note}</p>}{update.work_url && <a href={update.work_url} target="_blank" rel="noreferrer">Buka tautan hasil ↗</a>}{evidenceUrls.get(update.id) && <a href={evidenceUrls.get(update.id)} target="_blank" rel="noreferrer">Buka bukti kerja ↗</a>}</article>)}</div> : <EmptyState title="Belum ada pembaruan" description="Simpan progres pertama Anda." />}
        </section>
      </div>

      <aside class="stack">
        <section class="panel">
          <div class="panel-header"><div><h2>Perbarui progres</h2></div></div>
          <form method="POST" action={actions.updateTaskProgress} class="panel-body stack">
            <input type="hidden" name="taskId" value={task.id} />
            <label class="field">Progres (%)<input class="input" name="progress" type="number" min="0" max="100" value={task.progress} required /></label>
            <label class="field">Catatan<textarea class="textarea" name="note" maxlength="3000"></textarea></label>
            <label class="field">URL hasil<input class="input" name="workUrl" type="url" placeholder="https://" /></label>
            <button class="button" type="submit">Simpan progres</button>
          </form>
        </section>
        <section class="panel">
          <div class="panel-header"><div><h2>Unggah bukti</h2><p>PDF/JPG/PNG/WebP, maksimal 10 MB.</p></div></div>
          <form method="POST" action={actions.uploadTaskEvidence} enctype="multipart/form-data" class="panel-body stack">
            <input type="hidden" name="taskId" value={task.id} />
            <input class="input" name="evidence" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
            <button class="button secondary" type="submit">Unggah bukti</button>
          </form>
        </section>
      </aside>
    </div>
  )}
</AppLayout>

<style>
  .task-grid{display:grid;gap:1rem}.panel-body>p{margin:1rem 0;color:var(--muted)}.facts{display:grid;gap:.6rem}.facts div{display:flex;justify-content:space-between}.facts dt{color:var(--muted)}.facts dd{margin:0}.checklist{display:grid}.check-item{width:100%;display:flex;gap:.7rem;padding:.9rem 1.1rem;border:0;border-bottom:1px solid var(--line);background:white;text-align:left;cursor:pointer}.check-item span{width:22px;height:22px;border:1px solid var(--line-strong);border-radius:6px;text-align:center}.check-item.done{color:var(--muted);text-decoration:line-through}.updates article{padding:1rem 1.1rem;border-bottom:1px solid var(--line)}.updates article>div{display:flex;justify-content:space-between}.updates span{color:var(--muted);font-size:.72rem}.updates p{margin:.5rem 0}.updates a{display:block;color:var(--primary);font-size:.78rem}@media(min-width:960px){.task-grid{grid-template-columns:1.3fr .7fr}}
</style>
