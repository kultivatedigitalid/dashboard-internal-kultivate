---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import StatBlock from '@/components/StatBlock.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData } from '@/lib/dashboard-data';
import { formatDate, formatIDR } from '@/lib/formatters';
import { jakartaDate } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.createAllowance);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const entries = data?.allowances ?? [];
const total = (status: string) => entries.filter((row) => row.status === status).reduce((sum, row) => sum + row.transport_amount + row.meal_amount, 0);
---

<AppLayout title="Tunjangan" heading="Tunjangan" description="Catat biaya transportasi dan makan untuk direview admin." role="employee" user={user} activePath="/app/allowances">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}

  <section class="metrics-grid">
    <StatBlock label="Disetujui" value={formatIDR(total('approved'))} helper="terverifikasi admin" />
    <StatBlock label="Menunggu review" value={formatIDR(total('submitted'))} helper="sedang diperiksa" />
    <StatBlock label="Draft" value={formatIDR(total('draft'))} helper="belum dikirim" />
    <StatBlock label="Ditolak" value={formatIDR(total('rejected'))} helper="perlu diperiksa" />
  </section>

  <section class="panel form-panel">
    <div class="panel-header"><div><h2>Pengajuan baru</h2><p>Minimal salah satu nominal lebih dari nol.</p></div></div>
    <form method="POST" action={actions.createAllowance} class="panel-body allowance-fields">
      <label class="field">Tanggal<input class="input" name="expenseDate" type="date" value={jakartaDate()} required /></label>
      <label class="field">Transportasi<input class="input" name="transportAmount" type="number" min="0" step="1000" value="0" required /></label>
      <label class="field">Uang makan<input class="input" name="mealAmount" type="number" min="0" step="1000" value="0" required /></label>
      <label class="field wide">Catatan<textarea class="textarea" name="notes" maxlength="2000"></textarea></label>
      <div class="cluster wide"><button class="button secondary" name="intent" value="draft" type="submit">Simpan draft</button><button class="button" name="intent" value="submit" type="submit">Kirim pengajuan</button></div>
    </form>
  </section>

  <section class="panel list-panel">
    <div class="panel-header"><div><h2>Riwayat pengajuan</h2></div></div>
    {entries.length ? <div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Transport</th><th>Makan</th><th>Total</th><th>Status</th><th>Catatan review</th></tr></thead><tbody>{entries.map((row) => <tr><td>{formatDate(row.expense_date)}</td><td>{formatIDR(row.transport_amount)}</td><td>{formatIDR(row.meal_amount)}</td><td><strong>{formatIDR(row.transport_amount + row.meal_amount)}</strong></td><td><StatusBadge label={row.status} tone={row.status === 'approved' ? 'success' : row.status === 'rejected' ? 'danger' : 'warning'} /></td><td>{row.review_note ?? '—'}</td></tr>)}</tbody></table></div> : <EmptyState title="Belum ada pengajuan" description="Pengajuan pertama Anda akan muncul di sini." />}
  </section>
</AppLayout>

<style>.form-panel,.list-panel{margin-top:1rem}.allowance-fields{display:grid;gap:1rem}@media(min-width:760px){.allowance-fields{grid-template-columns:repeat(3,1fr)}.wide{grid-column:1/-1}}</style>
