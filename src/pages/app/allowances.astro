---
import AppLayout from '@/layouts/AppLayout.astro';
import StatBlock from '@/components/StatBlock.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { employeeUser } from '@/lib/demo-data';
import { formatIDR } from '@/lib/formatters';

const user = Astro.locals.user ?? employeeUser;
const entries = [
  { date: '17 Jul 2026', transport: 50000, meal: 35000, total: 85000, status: 'Disetujui' },
  { date: '16 Jul 2026', transport: 0, meal: 35000, total: 35000, status: 'Dikirim' },
  { date: '14 Jul 2026', transport: 45000, meal: 35000, total: 80000, status: 'Ditolak' },
];
---

<AppLayout title="Tunjangan" heading="Tunjangan" description="Catat biaya transportasi dan makan, lalu kirim untuk ditinjau admin." role="employee" user={user} activePath="/app/allowances" isDemo={Astro.locals.isDemo}>
  <button slot="actions" class="button" type="button" data-entry-toggle>Tambah pengajuan</button>
  <section class="metrics-grid">
    <StatBlock label="Total Juli" value={formatIDR(475000)} helper="7 pengajuan" />
    <StatBlock label="Disetujui" value={formatIDR(355000)} helper="5 pengajuan" trend="Terverifikasi" tone="success" />
    <StatBlock label="Menunggu review" value={formatIDR(40000)} helper="1 pengajuan" trend="Diperiksa" tone="warning" />
    <StatBlock label="Perlu revisi" value={formatIDR(80000)} helper="1 pengajuan" trend="Perlu tindakan" tone="warning" />
  </section>

  <section class="panel allowance-form" data-entry-form hidden>
    <div class="panel-header"><div><h2>Pengajuan baru</h2><p>Minimal salah satu nominal lebih dari nol.</p></div><button class="button ghost" type="button" data-entry-close>Tutup</button></div>
    <form class="allowance-fields panel-body">
      <div class="field"><label for="allowance-date">Tanggal</label><input class="input" id="allowance-date" type="date" value="2026-07-20" required /></div>
      <div class="field"><label for="transport">Transportasi</label><input class="input" id="transport" type="number" min="0" step="1000" placeholder="Rp 0" /></div>
      <div class="field"><label for="meal">Uang makan</label><input class="input" id="meal" type="number" min="0" step="1000" placeholder="Rp 0" /></div>
      <div class="field wide"><label for="allowance-note">Catatan</label><textarea class="textarea" id="allowance-note" placeholder="Tujuan perjalanan atau keterangan biaya"></textarea></div>
      <div class="form-actions wide"><button class="button secondary" type="button">Simpan draft</button><button class="button" type="submit">Kirim pengajuan</button></div>
    </form>
  </section>

  <section class="panel allowance-list">
    <div class="panel-header"><div><h2>Riwayat pengajuan</h2><p>Nominal ditampilkan dalam Rupiah.</p></div><select class="select compact" aria-label="Filter bulan"><option>Juli 2026</option></select></div>
    <div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Transportasi</th><th>Makan</th><th>Total</th><th>Status</th><th>Aksi</th></tr></thead><tbody>{entries.map((entry) => <tr><td><strong>{entry.date}</strong></td><td>{formatIDR(entry.transport)}</td><td>{formatIDR(entry.meal)}</td><td><strong>{formatIDR(entry.total)}</strong></td><td><StatusBadge label={entry.status} tone={entry.status === 'Disetujui' ? 'success' : entry.status === 'Ditolak' ? 'danger' : 'info'} /></td><td><a class="text-link" href="#">Detail</a></td></tr>)}</tbody></table></div>
  </section>

  <script>
    const form = document.querySelector<HTMLElement>('[data-entry-form]');
    document.querySelector('[data-entry-toggle]')?.addEventListener('click', () => { if (form) { form.hidden = false; form.scrollIntoView({ behavior: 'smooth', block: 'start' }); } });
    document.querySelector('[data-entry-close]')?.addEventListener('click', () => { if (form) form.hidden = true; });
  </script>
</AppLayout>

<style>
  .allowance-form, .allowance-list { margin-top: 1rem; }
  .allowance-fields { display: grid; gap: 1rem; }
  .form-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .6rem; }
  .compact { width: auto; min-height: 38px; }
  @media (min-width: 760px) { .allowance-fields { grid-template-columns: repeat(3, 1fr); } .wide { grid-column: 1 / -1; } }
</style>
