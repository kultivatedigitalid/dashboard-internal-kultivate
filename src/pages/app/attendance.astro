---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData } from '@/lib/dashboard-data';
import { formatDate, formatDateTime } from '@/lib/formatters';
import { jakartaDate, netHours } from '@/lib/dates';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const checkInResult = Astro.getActionResult(actions.checkIn);
const checkOutResult = Astro.getActionResult(actions.checkOut);
let loadError = '';
let data;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const sessions = data?.sessions ?? [];
const today = sessions.find((row) => row.work_date === jakartaDate());
const statusLabel = { draft: 'Aktif', submitted: 'Menunggu review', approved: 'Disetujui', rejected: 'Ditolak' };
---

<AppLayout title="Absensi" heading="Absensi" description="Check-in, check-out, dan riwayat sesi kerja Anda." role="employee" user={user} activePath="/app/attendance">
  {loadError && <div class="alert danger" role="alert">{loadError}</div>}
  {checkInResult?.error && <div class="alert danger" role="alert">{checkInResult.error.message}</div>}
  {checkInResult && !checkInResult.error && <div class="alert success">{checkInResult.data.message}</div>}
  {checkOutResult?.error && <div class="alert danger" role="alert">{checkOutResult.error.message}</div>}
  {checkOutResult && !checkOutResult.error && <div class="alert success">{checkOutResult.data.message}</div>}

  <section class="panel attendance-action">
    <div>
      <span>Hari ini · {formatDate(new Date())}</span>
      <h2>{!today ? 'Belum check-in' : today.check_out ? 'Sesi kerja selesai' : 'Sesi kerja aktif'}</h2>
      {today && <p>Check-in {formatDateTime(today.check_in)}{today.check_out ? ` · Check-out ${formatDateTime(today.check_out)}` : ''}</p>}
    </div>
    {!today ? (
      <form method="POST" action={actions.checkIn} class="stack">
        <label class="field">Mode kerja<select class="select" name="workMode"><option value="office">Kantor</option><option value="remote">Remote</option></select></label>
        <label class="field">Catatan awal<textarea class="textarea" name="notes" maxlength="1000"></textarea></label>
        <button class="button" type="submit">Check-in sekarang</button>
      </form>
    ) : !today.check_out ? (
      <form method="POST" action={actions.checkOut} class="stack">
        <label class="field">Istirahat (menit)<input class="input" name="breakMinutes" type="number" min="0" max="1440" value="60" required /></label>
        <label class="field">Catatan aktivitas<textarea class="textarea" name="notes" maxlength="1000" required>{today.activity_note ?? ''}</textarea></label>
        <button class="button" type="submit">Check-out dan kirim review</button>
      </form>
    ) : <StatusBadge label={statusLabel[today.status]} tone={today.status === 'approved' ? 'success' : today.status === 'rejected' ? 'danger' : 'warning'} />}
  </section>

  <section class="panel history">
    <div class="panel-header"><div><h2>Riwayat absensi</h2><p>Data terbaru ditampilkan lebih dahulu.</p></div></div>
    {sessions.length ? <div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Check-in</th><th>Check-out</th><th>Durasi</th><th>Mode</th><th>Status</th></tr></thead><tbody>{sessions.map((row) => <tr><td>{formatDate(row.work_date)}</td><td>{formatDateTime(row.check_in)}</td><td>{row.check_out ? formatDateTime(row.check_out) : '—'}</td><td>{netHours(row.check_in, row.check_out, row.break_minutes).toFixed(1)} jam</td><td>{row.work_mode}</td><td><StatusBadge label={statusLabel[row.status]} tone={row.status === 'approved' ? 'success' : row.status === 'rejected' ? 'danger' : 'warning'} /></td></tr>)}</tbody></table></div> : <EmptyState title="Belum ada absensi" description="Lakukan check-in untuk memulai sesi pertama." />}
  </section>
</AppLayout>

<style>
  .attendance-action { display:grid; gap:1.5rem; padding:1.25rem; }
  .attendance-action p { margin-top:.5rem; color:var(--muted); }
  .attendance-action form { max-width:520px; }
  .history { margin-top:1rem; }
  @media(min-width:900px){.attendance-action{grid-template-columns:1fr 1fr}}
</style>
