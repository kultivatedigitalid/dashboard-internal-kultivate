---
import { actions } from 'astro:actions';
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { loadDashboardData } from '@/lib/dashboard-data';
import { currentWeekStart } from '@/lib/dates';
import { formatDate } from '@/lib/formatters';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const result = Astro.getActionResult(actions.saveWeeklyReport);
let loadError = '';
let data: Awaited<ReturnType<typeof loadDashboardData>> | undefined;
try { data = await loadDashboardData(Astro); } catch (error) { loadError = error instanceof Error ? error.message : 'Data gagal dimuat.'; }
const weekStart = currentWeekStart();
const report = data?.reports.find((row) => row.week_start === weekStart);
const previous = data?.reports.filter((row) => row.week_start !== weekStart).slice(0, 3) ?? [];
const locked = report && !['draft', 'rejected'].includes(report.status);
---

<AppLayout title="Laporan mingguan" heading="Laporan mingguan" description={`Periode mulai ${formatDate(weekStart)}.`} role="employee" user={user} activePath="/app/weekly-report">
  {loadError && <div class="alert danger">{loadError}</div>}
  {result?.error && <div class="alert danger" role="alert">{result.error.message}</div>}
  {result && !result.error && <div class="alert success">{result.data.message}</div>}
  {report && <StatusBadge label={report.status} tone={report.status === 'approved' ? 'success' : report.status === 'rejected' ? 'danger' : 'warning'} />}

  <div class="report-grid">
    <form method="POST" action={actions.saveWeeklyReport} class="panel panel-body stack">
      <input type="hidden" name="weekStart" value={weekStart} />
      <label class="field"><span class="field-label">Ringkasan <span class="required-mark" aria-hidden="true">*</span></span><textarea class="textarea tall" name="summary" maxlength="5000" required disabled={locked}>{report?.summary ?? ''}</textarea></label>
      <label class="field">Pencapaian<textarea class="textarea" name="achievements" maxlength="5000" disabled={locked}>{report?.achievements ?? ''}</textarea></label>
      <label class="field">Kendala<textarea class="textarea" name="blockers" maxlength="5000" disabled={locked}>{report?.blockers ?? ''}</textarea></label>
      <label class="field">Rencana berikutnya<textarea class="textarea" name="nextPlan" maxlength="5000" disabled={locked}>{report?.next_plan ?? ''}</textarea></label>
      <label class="field">URL video<input class="input" name="videoUrl" type="url" value={report?.video_url ?? ''} disabled={locked} /></label>
      {report?.review_note && <div class="alert danger"><strong>Catatan admin:</strong> {report.review_note}</div>}
      {!locked && <div class="cluster"><button class="button secondary" name="intent" value="draft" type="submit">Simpan draft</button><button class="button" name="intent" value="submit" type="submit">Kirim untuk direview</button></div>}
      {locked && <p class="muted">Laporan terkunci selama menunggu atau setelah disetujui.</p>}
    </form>
    <aside class="panel">
      <div class="panel-header"><div><h2>Laporan sebelumnya</h2></div></div>
      {previous.length ? <div>{previous.map((item) => <article class="previous"><strong>{formatDate(item.week_start)}</strong><StatusBadge label={item.status} tone={item.status === 'approved' ? 'success' : item.status === 'rejected' ? 'danger' : 'warning'} />{item.review_note && <p>{item.review_note}</p>}</article>)}</div> : <EmptyState title="Belum ada riwayat" description="Laporan yang lalu akan muncul di sini." />}
    </aside>
  </div>
</AppLayout>

<style>.report-grid{display:grid;gap:1rem;margin-top:1rem}.tall{min-height:150px}.previous{display:grid;gap:.5rem;padding:1rem;border-bottom:1px solid var(--line)}.previous p{color:var(--muted)}@media(min-width:960px){.report-grid{grid-template-columns:1.3fr .7fr}}</style>
