---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
---

<BaseLayout title="Lupa password" bodyClass="simple-auth">
  <main class="simple-auth-shell">
    <Logo />
    <section class="simple-auth-card">
      <a class="back-link" href="/login">← Kembali ke login</a>
      <h1>Atur ulang password</h1>
      <p>Masukkan email akun Anda. Jika terdaftar, kami akan mengirimkan tautan pemulihan.</p>
      <form class="stack">
        <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" autocomplete="email" required /></div>
        <button class="button" type="submit">Kirim tautan pemulihan</button>
      </form>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .simple-auth { background: var(--surface); }
  .simple-auth-shell { min-height: 100dvh; display: flex; flex-direction: column; align-items: center; padding: 2rem 1rem; }
  .simple-auth-card { width: min(100%, 460px); margin: auto; padding: clamp(1.3rem, 4vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius-card); background: white; }
  .simple-auth-card h1 { margin-top: 1.5rem; font-size: 1.65rem; }
  .simple-auth-card > p { margin: .65rem 0 1.5rem; color: var(--muted); }
  .back-link { color: var(--primary); font-size: .8rem; font-weight: 680; }
</style>
