---
import { actions, isInputError } from 'astro:actions';
import PasswordField from './PasswordField.astro';

interface Props { result?: any }
const { result } = Astro.props;
const schemaErrors = isInputError(result?.error) ? result.error.fields : {};
const businessField = result && !result.error && result.data?.success === false ? result.data.field : '';
const businessMessage = result && !result.error && result.data?.success === false ? result.data.message : '';
const fieldError = (name: string) => schemaErrors[name]?.join(', ') || (businessField === name ? businessMessage : undefined);
---

<section class="panel password-panel">
  <div class="panel-header"><div><h2>Ganti password</h2><p>Konfirmasi password lama sebelum membuat password baru.</p></div></div>
  <form method="POST" action={actions.changePassword} class="panel-body stack">
    {result?.error && !isInputError(result.error) && <div class="alert danger" role="alert">{result.error.message}</div>}
    {result && !result.error && result.data?.success === true && <div class="alert success" role="status">{result.data.message}</div>}
    <PasswordField label="Password lama" name="currentPassword" autocomplete="current-password" error={fieldError('currentPassword')} />
    <PasswordField label="Password baru" name="newPassword" autocomplete="new-password" error={fieldError('newPassword')} />
    <PasswordField label="Konfirmasi password baru" name="confirmPassword" autocomplete="new-password" error={fieldError('confirmPassword')} />
    <p class="field-hint">Gunakan minimal 8 karakter dan password yang berbeda dari password lama.</p>
    <button class="button" type="submit"><i class="ph ph-lock-key" aria-hidden="true"></i>Simpan password baru</button>
  </form>
</section>

<style>.password-panel form>.button{align-self:flex-start}</style>