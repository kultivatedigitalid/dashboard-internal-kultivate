---
interface Props {
  label: string;
  name: string;
  autocomplete: string;
  error?: string | undefined;
  placeholder?: string;
  minlength?: number;
}
const { label, name, autocomplete, error, placeholder = '', minlength = 8 } = Astro.props;
const inputId = `password-${name}`;
const errorId = `${inputId}-error`;
---

<label class="field password-field">
  <span class="field-label">{label} <span class="required-mark" aria-hidden="true">*</span></span>
  <span class="password-control">
    <input class="input" id={inputId} name={name} type="password" autocomplete={autocomplete} placeholder={placeholder} minlength={minlength} required aria-invalid={Boolean(error)} aria-describedby={error ? errorId : undefined} />
    <button class="password-toggle" type="button" data-password-toggle aria-label={`Tampilkan ${label.toLowerCase()}`} aria-pressed="false" aria-controls={inputId}>
      <i class="ph ph-eye" aria-hidden="true"></i>
    </button>
  </span>
  {error && <span class="field-error" id={errorId}>{error}</span>}
</label>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((button) => {
    if (button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      const inputId = button.getAttribute('aria-controls');
      const input = inputId ? document.getElementById(inputId) as HTMLInputElement | null : null;
      if (!input) return;
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      button.setAttribute('aria-pressed', String(show));
      button.setAttribute('aria-label', `${show ? 'Sembunyikan' : 'Tampilkan'} password`);
      const icon = button.querySelector('i');
      icon?.classList.toggle('ph-eye', !show);
      icon?.classList.toggle('ph-eye-slash', show);
      input.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .required-mark{color:var(--danger);font-weight:800}.password-control{position:relative;display:block}.password-control>.input{padding-right:3.2rem}.password-toggle{position:absolute;top:50%;right:.35rem;width:38px;height:38px;display:grid;place-items:center;transform:translateY(-50%);border:0;border-radius:8px;background:transparent;color:var(--muted);cursor:pointer;transition:background-color 160ms var(--ease-out),color 160ms var(--ease-out)}.password-toggle:active{transform:translateY(-50%) scale(.96)}
  @media(hover:hover) and (pointer:fine){.password-toggle:hover{background:var(--surface);color:var(--ink)}}
</style>