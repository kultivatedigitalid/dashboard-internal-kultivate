---
import { actions } from 'astro:actions';
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import type { AppRole, AppUser } from '@/lib/types';

interface Props {
  title: string;
  heading: string;
  description?: string;
  role: AppRole;
  user: AppUser;
  activePath: string;
  isDemo?: boolean;
}

const { title, heading, description, role, user, activePath, isDemo = false } = Astro.props;
const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error) {
  return Astro.redirect(logoutResult.data.redirectTo);
}

const employeeNavigation = [
  { href: '/app', label: 'Dashboard', glyph: '⌂' },
  { href: '/app/attendance', label: 'Absensi', glyph: '◷' },
  { href: '/app/tasks', label: 'Tugas', glyph: '✓' },
  { href: '/app/weekly-report', label: 'Laporan', glyph: '≡' },
  { href: '/app/allowances', label: 'Tunjangan', glyph: '₫' },
  { href: '/app/profile', label: 'Profil', glyph: '○' },
];

const adminNavigation = [
  { href: '/admin', label: 'Dashboard', glyph: '⌂' },
  { href: '/admin/employees', label: 'Karyawan', glyph: '◎' },
  { href: '/admin/tasks', label: 'Tugas', glyph: '✓' },
  { href: '/admin/targets', label: 'Target', glyph: '↗' },
  { href: '/admin/attendance', label: 'Absensi', glyph: '◷' },
  { href: '/admin/reports', label: 'Laporan', glyph: '≡' },
  { href: '/admin/allowances', label: 'Tunjangan', glyph: '₫' },
  { href: '/admin/evaluations', label: 'Evaluasi', glyph: '◇' },
  { href: '/admin/settings', label: 'Pengaturan', glyph: '⚙' },
];

const navigation = role === 'admin' ? adminNavigation : employeeNavigation;
const isActive = (href: string) => href === activePath || (href !== `/${role === 'admin' ? 'admin' : 'app'}` && activePath.startsWith(`${href}/`));
---

<BaseLayout title={title} bodyClass="app-body">
  {isDemo && <div class="demo-banner">Mode demo lokal · data hanya contoh dan tidak disimpan</div>}
  <div class="app-shell">
    <div class="drawer-backdrop" data-drawer-backdrop></div>
    <aside class="sidebar" data-sidebar aria-label="Navigasi utama">
      <div class="sidebar-head">
        <Logo inverse />
        <button class="sidebar-close" type="button" data-drawer-close aria-label="Tutup navigasi">×</button>
      </div>

      <div class="workspace-switcher">
        <span>Ruang kerja</span>
        <strong>Tim Internal</strong>
        <small>{role === 'admin' ? 'Akses administrator' : user.employeeCode ?? 'Karyawan'}</small>
      </div>

      <nav class="sidebar-nav">
        <span class="nav-label">Menu utama</span>
        {navigation.map((item) => (
          <a href={item.href} class:list={['nav-item', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="nav-glyph" aria-hidden="true">{item.glyph}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="sidebar-foot">
        <div class="sidebar-help">
          <strong>Butuh bantuan?</strong>
          <span>Lihat panduan penggunaan dashboard.</span>
          <a href="/help">Buka panduan <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <button class="menu-trigger icon-button" type="button" data-drawer-open aria-label="Buka navigasi">☰</button>
        <div class="topbar-context">
          <span>{role === 'admin' ? 'Admin' : 'Karyawan'}</span>
          <strong>{heading}</strong>
        </div>
        <div class="topbar-tools">
          <a class="topbar-icon" href={role === 'admin' ? '/admin/reports' : '/app/tasks'} aria-label="Lihat item yang membutuhkan perhatian">
            <span aria-hidden="true">●</span>
            <i></i>
          </a>
          <details class="user-menu">
            <summary aria-label="Buka menu pengguna">
              <span class="avatar">{user.avatar}</span>
              <span class="user-copy"><strong>{user.fullName}</strong><small>{role === 'admin' ? 'Administrator' : user.employeeCode}</small></span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="user-popover">
              <div class="popover-user"><strong>{user.fullName}</strong><span>{user.email}</span></div>
              <a href={role === 'admin' ? '/admin/settings' : '/app/profile'}>Pengaturan akun</a>
              <form method="POST" action={actions.logout}>
                <button type="submit">Keluar</button>
              </form>
            </div>
          </details>
        </div>
      </header>

      <main class="page-content" id="main-content">
        <div class="page-heading">
          <div>
            <h1>{heading}</h1>
            {description && <p>{description}</p>}
          </div>
          <div class="page-actions"><slot name="actions" /></div>
        </div>
        <slot />
      </main>
    </div>

    {role === 'employee' && (
      <nav class="bottom-nav" aria-label="Navigasi mobile">
        {employeeNavigation.slice(0, 5).map((item) => (
          <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span aria-hidden="true">{item.glyph}</span>
            <small>{item.label}</small>
          </a>
        ))}
      </nav>
    )}
  </div>

  <script>
    const sidebar = document.querySelector('[data-sidebar]');
    const backdrop = document.querySelector('[data-drawer-backdrop]');
    const openButton = document.querySelector('[data-drawer-open]');
    const closeButton = document.querySelector('[data-drawer-close]');

    const setDrawer = (open: boolean) => {
      sidebar?.classList.toggle('open', open);
      backdrop?.classList.toggle('open', open);
      document.body.classList.toggle('drawer-open', open);
      openButton?.setAttribute('aria-expanded', String(open));
    };

    openButton?.addEventListener('click', () => setDrawer(true));
    closeButton?.addEventListener('click', () => setDrawer(false));
    backdrop?.addEventListener('click', () => setDrawer(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setDrawer(false);
    });
  </script>
</BaseLayout>

<style is:global>
  .app-body { background: var(--surface); }
  .app-shell { min-height: 100dvh; }
  .sidebar {
    position: fixed; inset: 0 auto 0 0; z-index: var(--z-drawer); width: min(var(--sidebar-width), 86vw); height: 100dvh;
    display: flex; flex-direction: column; padding: 1.1rem; background: var(--sidebar); color: white;
    transform: translateX(-105%); transition: transform 220ms cubic-bezier(.16,1,.3,1);
  }
  .sidebar.open { transform: translateX(0); }
  .sidebar-head { height: 48px; display: flex; align-items: center; justify-content: space-between; }
  .sidebar-close { width: 40px; height: 40px; border: 0; border-radius: 9px; background: oklch(1 0 0 / .08); color: white; font-size: 1.4rem; cursor: pointer; }
  .workspace-switcher { display: grid; margin: 1.4rem 0 1.25rem; padding: .8rem .85rem; border: 1px solid oklch(1 0 0 / .1); border-radius: 11px; background: oklch(1 0 0 / .05); }
  .workspace-switcher span, .workspace-switcher small { color: var(--sidebar-muted); font-size: .68rem; }
  .workspace-switcher strong { margin: .15rem 0; font-size: .82rem; }
  .sidebar-nav { display: grid; gap: .18rem; overflow-y: auto; }
  .nav-label { padding: .25rem .7rem .5rem; color: var(--sidebar-muted); font-size: .67rem; font-weight: 700; }
  .nav-item { min-height: 42px; display: flex; align-items: center; gap: .75rem; padding: .52rem .7rem; border-radius: 9px; color: var(--sidebar-muted); font-size: .84rem; font-weight: 570; transition: background 160ms ease-out, color 160ms ease-out; }
  .nav-item:hover { background: oklch(1 0 0 / .07); color: white; }
  .nav-item.active { background: white; color: var(--sidebar); font-weight: 720; }
  .nav-glyph { width: 22px; display: inline-grid; place-items: center; font-size: 1rem; }
  .sidebar-foot { margin-top: auto; padding-top: 1rem; }
  .sidebar-help { display: grid; gap: .25rem; padding: .9rem; border-top: 1px solid oklch(1 0 0 / .12); }
  .sidebar-help strong { font-size: .78rem; }
  .sidebar-help span { color: var(--sidebar-muted); font-size: .69rem; line-height: 1.4; }
  .sidebar-help a { margin-top: .35rem; color: white; font-size: .72rem; font-weight: 700; }
  .drawer-backdrop { position: fixed; inset: 0; z-index: var(--z-backdrop); background: oklch(0.08 0 0 / .56); opacity: 0; pointer-events: none; transition: opacity 180ms ease-out; }
  .drawer-backdrop.open { opacity: 1; pointer-events: auto; }
  .drawer-open { overflow: hidden; }
  .app-main { min-width: 0; }
  .topbar { position: sticky; top: 0; z-index: var(--z-sticky); height: var(--topbar-height); display: flex; align-items: center; gap: .7rem; padding: 0 1rem; border-bottom: 1px solid var(--line); background: oklch(1 0 0 / .94); backdrop-filter: blur(10px); }
  .topbar-context { min-width: 0; display: grid; margin-right: auto; line-height: 1.2; }
  .topbar-context span { color: var(--muted); font-size: .67rem; }
  .topbar-context strong { overflow: hidden; font-size: .82rem; text-overflow: ellipsis; white-space: nowrap; }
  .topbar-tools { display: flex; align-items: center; gap: .35rem; }
  .topbar-icon { position: relative; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 9px; color: var(--muted); }
  .topbar-icon:hover { background: var(--surface); color: var(--ink); }
  .topbar-icon i { position: absolute; top: 9px; right: 9px; width: 7px; height: 7px; border: 2px solid white; border-radius: 50%; background: var(--accent); }
  .user-menu { position: relative; }
  .user-menu summary { min-height: 46px; display: flex; align-items: center; gap: .6rem; padding: .25rem; border-radius: 10px; cursor: pointer; list-style: none; }
  .user-menu summary::-webkit-details-marker { display: none; }
  .user-menu summary:hover { background: var(--surface); }
  .user-copy { display: none; line-height: 1.2; }
  .user-copy strong, .user-copy small { display: block; }
  .user-copy strong { max-width: 150px; overflow: hidden; font-size: .76rem; text-overflow: ellipsis; white-space: nowrap; }
  .user-copy small { margin-top: .18rem; color: var(--muted); font-size: .65rem; }
  .chevron { display: none; color: var(--muted); }
  .user-popover { position: fixed; top: calc(var(--topbar-height) - 4px); right: 1rem; z-index: var(--z-dropdown); width: min(260px, calc(100vw - 2rem)); padding: .5rem; border: 1px solid var(--line); border-radius: 12px; background: white; box-shadow: var(--shadow-float); }
  .popover-user { display: grid; padding: .6rem .65rem .75rem; border-bottom: 1px solid var(--line); }
  .popover-user strong { font-size: .82rem; }
  .popover-user span { color: var(--muted); font-size: .72rem; }
  .user-popover a, .user-popover button { width: 100%; min-height: 40px; display: flex; align-items: center; padding: .45rem .65rem; border: 0; border-radius: 8px; background: transparent; color: var(--ink-soft); font-size: .8rem; text-align: left; cursor: pointer; }
  .user-popover a:hover, .user-popover button:hover { background: var(--surface); color: var(--ink); }
  .page-content { width: min(100%, 1440px); margin: 0 auto; padding: 1.25rem 1rem 6.5rem; }
  .page-heading { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.2rem; }
  .page-heading h1 { font-size: 1.45rem; font-weight: 760; }
  .page-heading p { max-width: 68ch; margin-top: .35rem; color: var(--muted); font-size: .84rem; }
  .page-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; }
  .bottom-nav { position: fixed; inset: auto 0 0; z-index: var(--z-sticky); min-height: 68px; display: grid; grid-template-columns: repeat(5, 1fr); padding: .4rem .25rem max(.4rem, env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: oklch(1 0 0 / .97); backdrop-filter: blur(12px); }
  .bottom-nav a { min-width: 0; min-height: 52px; display: grid; place-items: center; align-content: center; gap: .1rem; border-radius: 9px; color: var(--muted); }
  .bottom-nav a > span { font-size: 1rem; }
  .bottom-nav small { max-width: 100%; overflow: hidden; font-size: .62rem; text-overflow: ellipsis; white-space: nowrap; }
  .bottom-nav a.active { background: var(--primary-soft); color: var(--primary); font-weight: 750; }

  @media (min-width: 700px) {
    .page-content { padding: 1.7rem 1.6rem 3rem; }
    .user-copy, .chevron { display: block; }
  }

  @media (min-width: 1024px) {
    .sidebar { transform: none; }
    .sidebar-close, .menu-trigger, .drawer-backdrop { display: none; }
    .app-main { margin-left: var(--sidebar-width); }
    .topbar { padding: 0 1.75rem; }
    .page-content { padding: 2rem 1.75rem 3rem; }
    .bottom-nav { display: none; }
    .user-popover { position: absolute; top: calc(100% + .4rem); right: 0; }
  }
</style>
